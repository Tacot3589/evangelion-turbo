void HAL_I2C_MemRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c == &hi2c2)
    {
		int16_t abs_x;
		int16_t abs_y;
		int16_t abs_z;

    	//TODO jakas filtracja or smth
    	//1000 = 1g
		Eva.Accel.y = 0 - (int16_t)(I2C2_Accel_Rx[2] | (I2C2_Accel_Rx[3] << 8)) * 1000.0f / 2048.0f; //accel x - side to side robot
		Eva.Accel.x = 0 - (int16_t)(I2C2_Accel_Rx[4] | (I2C2_Accel_Rx[5] << 8)) * 1000.0f / 2048.0f; //accel y - front back robot
		Eva.Accel.z =     (int16_t)(I2C2_Accel_Rx[6] | (I2C2_Accel_Rx[7] << 8)) * 1000.0f / 2048.0f; //accel z - up down robot

		abs_x = ABS(Eva.Accel.x);
		abs_y = ABS(Eva.Accel.y);
		abs_z = ABS(Eva.Accel.z);
		if (abs_x > Eva.Accel.peak) Eva.Accel.peak = abs_x;
		if (abs_y > Eva.Accel.peak) Eva.Accel.peak = abs_y;
		if (abs_z > Eva.Accel.peak) Eva.Accel.peak = abs_z;



		//16 = 1deg/sek
		Eva.Gyro.y = 0 + (int16_t)(I2C2_Accel_Rx[8] | (I2C2_Accel_Rx[9] << 8));
		Eva.Gyro.x = 0 - (int16_t)(I2C2_Accel_Rx[10] | (I2C2_Accel_Rx[11] << 8));
		Eva.Gyro.z = 0 - (int16_t)(I2C2_Accel_Rx[12] | (I2C2_Accel_Rx[13] << 8));

		abs_x = ABS(Eva.Gyro.x);
		abs_y = ABS(Eva.Gyro.y);
		abs_z = ABS(Eva.Gyro.z);
		if (abs_x > Eva.Gyro.peak) Eva.Gyro.peak = abs_x;
		if (abs_y > Eva.Gyro.peak) Eva.Gyro.peak = abs_y;
		if (abs_z > Eva.Gyro.peak) Eva.Gyro.peak = abs_z;


		//10 = 1 deg of celcius
		// + 230
		Eva.ImuTemp = ((int16_t)(I2C2_Accel_Rx[14] | (I2C2_Accel_Rx[15] << 8)) / 51.2f + 230);
    }

    if(hi2c == &hi2c1)
    {
    	//if(SWITCH_SIDE_LIDARS == false)
    	if(true)
    	{
    		if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY)
    		{
    			LeftSide.Distance = (TFLUNA1_I2C_RX_BUFFER[1] << 8) | TFLUNA1_I2C_RX_BUFFER[0];
    		}
    	}
    }
}

