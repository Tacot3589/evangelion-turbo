//=====ATTACK MODES
void STRAIGHT_ATTACK()
{
	if(Left.Line == OUT && Right.Line == OUT)
	{
		Motors.Requested.L = -100;
		Motors.Requested.R = -100;
	}
	else if(Left.Distance <= MAX_DISTANCE && Right.Distance <= MAX_DISTANCE)
	{
		//TODO XD
		if(Left.LidarAmp*2 < Right.LidarAmp)
		{
			Motors.Requested.L = 40;
			Motors.Requested.R = 100;
		}
		else if(Left.LidarAmp > Right.LidarAmp*2)
		{
			Motors.Requested.L = 100;
			Motors.Requested.R = 40;
		}
		else
		{
			Motors.Requested.L = 100;
			Motors.Requested.R = 100;
		}
	}
	else if(Left.Distance <= MAX_DISTANCE)
	{
		Motors.Requested.L = 50;
		Motors.Requested.R = 75;
		lastSeen = LEFT;
	}
	else if(Right.Distance <= MAX_DISTANCE)
	{
		Motors.Requested.L = 75;
		Motors.Requested.R = 50;
		lastSeen = RIGHT;
	}
	else if(lastSeen == LEFT)
	{
		Motors.Requested.L = 0;
		Motors.Requested.R = 100;
	}
	else if(lastSeen == RIGHT)
	{
		Motors.Requested.L = 100;
		Motors.Requested.R = 0;
	}
	else
	{
		Motors.Requested.L = 100;
		Motors.Requested.R = -100;
	}
}

//=====MAIN FUNCIONTS
void WATCHDOG()
{

	//BATERRY
	static uint16_t bufr[BATTERY_ADC_READOUT_BUFFER_SIZE] = {0};
	static uint8_t i=0;
	static uint16_t bat_sum=0;
	bat_sum = bat_sum - bufr[i] + ADC_BUFFER[0];
	bufr[i] = ADC_BUFFER[0];
	i = (i+1) % BATTERY_ADC_READOUT_BUFFER_SIZE;

	Eva.Voltage = (uint16_t)(bat_sum / BATTERY_ADC_READOUT_BUFFER_SIZE * BATTERY_CONST);
	Eva.CellVoltage = (uint16_t)(Eva.Voltage / Eva.BattType);
	if (Eva.CellVoltage <= (MIN_BATTERY_VOLTAGE_PER_CELL * 100))
		COOKED(LOW_BATTERY_VOLTAGE);
	else if(ERROR_FLAG == LOW_BATTERY_VOLTAGE)
		ERROR_FLAG = 0;


	if(Eva.Interface.Switch3 != !HAL_GPIO_ReadPin(SWITCH1_GPIO_Port, SWITCH1_Pin)) //MICROMOUSE MODE
	{
		Eva.AttackMode = MICROMOUSE;
		NVIC_SystemReset();
	}

	//INTERACTIVE INTERFACE
	Eva.Interface.Switch1 = !HAL_GPIO_ReadPin(SWITCH2_GPIO_Port, SWITCH2_Pin);
	Eva.Interface.Switch2 = !HAL_GPIO_ReadPin(SWITCH3_GPIO_Port, SWITCH3_Pin);
	Eva.Interface.Switch3 = !HAL_GPIO_ReadPin(SWITCH1_GPIO_Port, SWITCH1_Pin);
	if(Eva.Interface.Joystick == BUTTON_REBOUNCE && HAL_GPIO_ReadPin(JOY1_GPIO_Port, JOY1_Pin) && HAL_GPIO_ReadPin(JOY2_GPIO_Port, JOY2_Pin) &&
			HAL_GPIO_ReadPin(JOY5_GPIO_Port, JOY5_Pin) && HAL_GPIO_ReadPin(JOY3_GPIO_Port, JOY3_Pin) && HAL_GPIO_ReadPin(JOY4_GPIO_Port, JOY4_Pin))
	{
		Eva.Interface.Joystick = NOTHING;
	}
	if(Eva.Interface.Joystick != BUTTON_REBOUNCE)
	{
		if(!HAL_GPIO_ReadPin(JOY1_GPIO_Port, JOY1_Pin))
			Eva.Interface.Joystick = UP_LEFT;
		else if(!HAL_GPIO_ReadPin(JOY2_GPIO_Port, JOY2_Pin))
			Eva.Interface.Joystick = UP_RIGHT;
		else if(!HAL_GPIO_ReadPin(JOY5_GPIO_Port, JOY5_Pin))
			Eva.Interface.Joystick = DOWN_LEFT;
		else if(!HAL_GPIO_ReadPin(JOY3_GPIO_Port, JOY3_Pin))
			Eva.Interface.Joystick = DOWN_RIGHT;
		else if(!HAL_GPIO_ReadPin(JOY4_GPIO_Port, JOY4_Pin))
			Eva.Interface.Joystick = CENTER;
	}

	if(Left.Distance <= INTRO_MIN_DISTANCE_FOR_LAST_SEEN)
		lastSeen = LEFT;
	if(Right.Distance <= INTRO_MIN_DISTANCE_FOR_LAST_SEEN)
			lastSeen = RIGHT;
}

void GET_START_MOD()
{
	StartMod.Started = HAL_GPIO_ReadPin(START_MOD_DIGITAL_INPUT_GPIO_Port, START_MOD_DIGITAL_INPUT_Pin);
	StartMod.StartedViaSwitch = Eva.Interface.Switch1;


	if(StartMod.Delay == 0){
		if((StartMod.Started && !Settings.IGNORE_START_MODULE) || Settings.ALWAYS_IN_BATTLE == true || StartMod.StartedViaSwitch == true || StartMod.StartedViaInterface == true)
		{
			Eva.inBattle = true;
		}
		else
		{
			SET_MOTORS(0,0);
			TIM2->CCR1 = 0; //L front
			TIM2->CCR2 = 0; //L back
			TIM2->CCR3 = 0; //R front
			TIM2->CCR4 = 0; //R back
			Eva.inBattle = false;
			StartMod.StartedViaInterface = false;
			StartMod.VolatileDelayTimer = 0;
		}
	}
	else
	{
		if(StartMod.Delay != 0 && ((StartMod.Started && !Settings.IGNORE_START_MODULE) || StartMod.StartedViaInterface || StartMod.StartedViaSwitch) && Eva.inBattle == false){
			if(StartMod.VolatileDelayTimer >= StartMod.Delay)
			{
				StartMod.VolatileDelayTimer = 0;
				Eva.inBattle = true;
			}
			else
			{
				StartMod.VolatileDelayTimer = StartMod.VolatileDelayTimer + 1;
			}
		}

		else if((StartMod.Started == false && !Settings.IGNORE_START_MODULE) && (StartMod.StartedViaInterface == false) && (StartMod.StartedViaSwitch == false))
		{
			SET_MOTORS(0,0);
			TIM2->CCR1 = 0; //L front
			TIM2->CCR2 = 0; //L back
			TIM2->CCR3 = 0; //R front
			TIM2->CCR4 = 0; //R back
			Eva.inBattle = false;
			StartMod.StartedViaInterface = false;
			StartMod.VolatileDelayTimer = 0;
		}
	}



	static uint8_t turned_off = false;
	if(Eva.inBattle == false && turned_off == false){
	    SET_MOTORS(0,0);
	    turned_off = true;
	}

	if(Eva.inBattle == true){
	    turned_off = false;
	}
}

void BATTLE()
{
	if(Eva.AttackMode == STRAIGHT)
		STRAIGHT_ATTACK();
	else if(Eva.AttackMode == MICROMOUSE)
		ARDUINO_MAIN();
	else
		STRAIGHT_ATTACK();

	CALCULATE_MOTOR_SPEEDS(Motors.Requested.L, Motors.Requested.R);
	SET_MOTORS(Motors.Set.L, Motors.Set.R);
}

