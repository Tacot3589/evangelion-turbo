void LIDARS_INIT()
{
	uint8_t counter=0;

	//LIDARS OFF
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x00;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	while(true)
	{
		HAL_UART_Transmit(&huart1, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart1, UART1_RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(UART1_RX[0] == UART_TX[0] && UART1_RX[1] == UART_TX[1] && UART1_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR1 * (SWITCH_LIDARS==false) + RIGHT_LIDAR_INIT_ERR1 * (SWITCH_LIDARS==true));
		counter++;
	}
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(&huart2, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart2, UART2_RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(UART2_RX[0] == UART_TX[0] && UART2_RX[1] == UART_TX[1] && UART2_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR1 * (SWITCH_LIDARS==true) + RIGHT_LIDAR_INIT_ERR1 * (SWITCH_LIDARS==false));
		counter++;
	}
	HAL_Delay(50);


	//LIDARS SET 250Hz
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x06;
	UART_TX[2] = 0x03;
	UART_TX[3] = 0xFA;
	UART_TX[4] = 0x00;
	UART_TX[5] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(&huart1, UART_TX, 6, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart1, UART1_RX, 6, LIDARS_INIT_UART_TIMEOUT);

		if(UART1_RX[0] == UART_TX[0] && UART1_RX[1] == UART_TX[1] && UART1_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR2 * (SWITCH_LIDARS==false) + RIGHT_LIDAR_INIT_ERR2 * (SWITCH_LIDARS==true));
		counter++;
	}
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(&huart2, UART_TX, 6, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart2, UART2_RX, 6, LIDARS_INIT_UART_TIMEOUT);

		if(UART2_RX[0] == UART_TX[0] && UART2_RX[1] == UART_TX[1] && UART2_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR2 * (SWITCH_LIDARS==true) + RIGHT_LIDAR_INIT_ERR2 * (SWITCH_LIDARS==false));
		counter++;
	}
	HAL_Delay(50);



	//LIDARS ON
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x01;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(&huart1, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart1, UART1_RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(UART1_RX[0] == UART_TX[0] && UART1_RX[1] == UART_TX[1] && UART1_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR3 * (SWITCH_LIDARS==false) + RIGHT_LIDAR_INIT_ERR3 * (SWITCH_LIDARS==true));
		counter++;
	}
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(&huart2, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(&huart2, UART2_RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(UART2_RX[0] == UART_TX[0] && UART2_RX[1] == UART_TX[1] && UART2_RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR3 * (SWITCH_LIDARS==true) + RIGHT_LIDAR_INIT_ERR3 * (SWITCH_LIDARS==false));
		counter++;
	}
	HAL_Delay(50);


	counter=0;
	while(true)
	{

		if(huart1.RxState == HAL_UART_STATE_READY && huart1.gState == HAL_UART_STATE_READY && huart1.ErrorCode == HAL_UART_ERROR_NONE)
			break;
		else if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR4 * (SWITCH_LIDARS==false) + RIGHT_LIDAR_INIT_ERR4 * (SWITCH_LIDARS==true));

		HAL_Delay(LIDARS_INIT_UART_TIMEOUT);
		counter++;
	}

	counter=0;
	while(true)
	{
		if(huart2.RxState == HAL_UART_STATE_READY && huart2.gState == HAL_UART_STATE_READY && huart2.ErrorCode == HAL_UART_ERROR_NONE)
			break;
		else if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LEFT_LIDAR_INIT_ERR4 * (SWITCH_LIDARS==true) + RIGHT_LIDAR_INIT_ERR4 * (SWITCH_LIDARS==false));

		HAL_Delay(LIDARS_INIT_UART_TIMEOUT);
		counter++;
	}
	HAL_Delay(50);


	HAL_UART_AbortReceive(&huart1);
	__HAL_UART_CLEAR_OREFLAG(&huart1);
	huart1.ErrorCode = HAL_UART_ERROR_NONE;
	huart1.RxState   = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(&huart1, UART1_RX, 9) != HAL_OK)
		COOKED(LEFT_LIDAR_UART_ERR * (SWITCH_LIDARS==false) + RIGHT_LIDAR_UART_ERR * (SWITCH_LIDARS==true));
	__HAL_DMA_DISABLE_IT(&hdma_usart1_rx, DMA_IT_HT);


	HAL_UART_AbortReceive(&huart2);
	__HAL_UART_CLEAR_OREFLAG(&huart2);
	huart2.ErrorCode = HAL_UART_ERROR_NONE;
	huart2.RxState   = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(&huart2, UART2_RX, 9) != HAL_OK)
		COOKED(LEFT_LIDAR_UART_ERR * (SWITCH_LIDARS==true) + RIGHT_LIDAR_UART_ERR * (SWITCH_LIDARS==false));
	__HAL_DMA_DISABLE_IT(&hdma_usart2_rx, DMA_IT_HT);

}

