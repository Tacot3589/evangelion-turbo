  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_I2C1_Init();
  MX_TIM2_Init();
  MX_I2C2_Init();
  MX_ADC2_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_TIM6_Init();
  MX_TIM7_Init();
  MX_TIM16_Init();
  MX_TIM17_Init();
  /* USER CODE BEGIN 2 */

  //variables
	Left.Distance = UINT16_MAX;
	Left.LidarAmp = UINT16_MAX;
	Left.LidarTemp = UINT16_MAX;
	Left.Line = IN;
	Right.Line = IN;
	Right.Distance = UINT16_MAX;
	Right.LidarAmp = UINT16_MAX;
	Right.LidarTemp = UINT16_MAX;
	Eva.Interface.MenuOption=0;
	Eva.BattType = DEFAULT_SETTING_BATTERY_CELL_NO;
	Eva.AttackMode = DEFAULT_ATTACK_MODE_ID;

	Settings.DONT_USE_MOTORS = DEFAULT_SETTING_DONT_USE_MOTORS;
	Settings.ALWAYS_IN_BATTLE = DEFAULT_SETTING_ALWAYS_IN_BATTLE;
	Settings.IGNORE_START_MODULE = DEFAULT_SETTING_IGNORE_START_MODULE;
	Settings.LINE_SENSORS_ALWAYS_IN = DEFAULT_SETTING_LINE_SENSORS_ALWAYS_IN;
	Settings.IGNORE_ACCEL = DEFAULT_SETTING_IGNORE_ACCEL;
	Settings.ENABLE_BUZZER = DEFAULT_SETTING_ENABLE_BUZZER;
	Settings.DONT_INITIALIZE_LIDARS = DEFAULT_SETTING_DONT_INITIALIZE_LIDARS;
	Settings.ALWAYS_SHOW_OLED = DEFAULT_SETTING_ALWAYS_SHOW_OLED;
  HAL_Delay(50);

  //Settings
	Eva.Interface.Switch1 = !HAL_GPIO_ReadPin(SWITCH2_GPIO_Port, SWITCH2_Pin); //startModuse
	Eva.Interface.Switch2 = !HAL_GPIO_ReadPin(SWITCH3_GPIO_Port, SWITCH3_Pin); //Mode
	Eva.Interface.Switch3 = !HAL_GPIO_ReadPin(SWITCH1_GPIO_Port, SWITCH1_Pin); //MicroMouse?
/*
	if(Eva.Interface.Switch3 == true)
		Eva.AttackMode = MICROMOUSE;
	else
		Eva.AttackMode = DEFAULT_ATTACK_MODE_ID;
	HAL_Delay(50);
*/
	Eva.AttackMode = DEFAULT_ATTACK_MODE_ID;

  //START MOD
  if(HAL_GPIO_ReadPin(START_MOD_DIGITAL_INPUT_GPIO_Port, START_MOD_DIGITAL_INPUT_Pin) == 1 && Settings.IGNORE_START_MODULE==0)
	  COOKED(START_SIGNAL_AT_STARTUP);

	HAL_UART_AbortReceive(&huart3);
	__HAL_UART_CLEAR_OREFLAG(&huart3);
	huart3.ErrorCode = HAL_UART_ERROR_NONE;
	huart3.RxState   = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(&huart3, UART3_RX, 4) != HAL_OK)
		COOKED(START_MOD_UART_CONNECTION_COOKED);
	//__HAL_DMA_DISABLE_IT(&hdma_usart1_rx, DMA_IT_HT);
  HAL_Delay(50);

  uint16_t freq;
  int16_t FREQ_STEP;
  if(Eva.AttackMode == MICROMOUSE)
  {

	freq=FREQ_STARTING_MICROMOUSE;
	FREQ_STEP = FREQ_STEP_INIT_MICROMOUSE;
	PLAY_FREQ(freq);
	freq = freq + FREQ_STEP;
  }
  else
  {
	freq=FREQ_STARTING;
	FREQ_STEP = FREQ_STEP_INIT;
	PLAY_FREQ(freq);
	freq = freq + FREQ_STEP;
  }




  //OLED
  if(Eva.AttackMode != MICROMOUSE)
  {
	  if(ssd1306_Init() != 0) //fuck nah
		  COOKED(OLED_INIT_ERR);
	  ssd1306_ResetOrientation();
	  ssd1306_SetColor(White);
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("ROBOILO", 0, BIG);
	  _ssd1306_WriteInTheMiddle("awakening evangelion", 22, SMALL);
	  ssd1306_UpdateScreen();
  }
  HAL_Delay(50);
  PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
  freq = freq + FREQ_STEP;

  //ADCs
  if(Eva.AttackMode != MICROMOUSE)
  {
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
	  _ssd1306_WriteInTheMiddle("ADCs setup", 22, SMALL);
	  ssd1306_UpdateScreen();
  }

  if (HAL_ADCEx_Calibration_Start(&hadc2, ADC_SINGLE_ENDED) != HAL_OK)
	  COOKED(ADC2_INIT_ERR);
  HAL_Delay(50);


  if (HAL_ADC_Start_DMA(&hadc2, (uint32_t*)ADC_BUFFER, 1) != HAL_OK)
	  COOKED(ADC2_BUFFER_INIT_ERR);
  HAL_Delay(50);
  PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
  freq = freq + FREQ_STEP;


  //LIDARS
  if(Settings.DONT_INITIALIZE_LIDARS == false)
  {

		if(Eva.AttackMode != MICROMOUSE)
		{
			ssd1306_Clear();
			  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
			_ssd1306_WriteInTheMiddle("LIDARS setup", 22, SMALL);
			ssd1306_UpdateScreen();
		}
		LIDARS_INIT();
		if(Eva.AttackMode == MICROMOUSE)
			TFLUNA_HAT_VIA_I2C_INIT();
		HAL_Delay(50);
		PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
		freq = freq + FREQ_STEP;
	}


  //IMU

  if(Eva.AttackMode != MICROMOUSE)
  {
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
	  _ssd1306_WriteInTheMiddle("accel setup", 22, SMALL);
	  ssd1306_UpdateScreen();
  }
  IMU_INIT();
  HAL_Delay(50);
  PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
  freq = freq + FREQ_STEP;


  //MOTORS
	if(Eva.AttackMode != MICROMOUSE)
	{
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
	  _ssd1306_WriteInTheMiddle("motors setup", 22, SMALL);
	  ssd1306_UpdateScreen();
	}

  if(HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1) != HAL_OK) //MOTOR
	  COOKED(TIM1_INIT_ERR);
  if(HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2) != HAL_OK) //MOTOR
	  COOKED(TIM2_INIT_ERR);
  if(HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3) != HAL_OK) //MOTOR
	  COOKED(TIM3_INIT_ERR);
  if(HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_4) != HAL_OK) //MOTOR
	  COOKED(TIM4_INIT_ERR);
  HAL_Delay(50);
  PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
  freq = freq + FREQ_STEP;

  //ITs
	if(Eva.AttackMode != MICROMOUSE)
	{
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
	  _ssd1306_WriteInTheMiddle("interrupts", 22, SMALL);
	  ssd1306_UpdateScreen();
	}

  if(HAL_TIM_Base_Start_IT(&htim4) != HAL_OK) //1000Hz BATTLE
	  COOKED(BATTLE_TIM_INIT_ERR);
  if(HAL_TIM_Base_Start_IT(&htim6) != HAL_OK) //100Hz watchdog
	  COOKED(WATCHDOG_TIM_INIT_ERR);
  if(HAL_TIM_Base_Start_IT(&htim7) != HAL_OK) //25hz OLED
	  COOKED(OLED_TIM_INIT_ERR);
  HAL_Delay(50);
  PLAY_FREQ(freq * (Settings.ENABLE_BUZZER==false));
  freq = freq + FREQ_STEP;

  //start mod
	HAL_UART_AbortReceive(&huart3);
	__HAL_UART_CLEAR_OREFLAG(&huart3);
	huart3.ErrorCode = HAL_UART_ERROR_NONE;
	huart3.RxState   = HAL_UART_STATE_READY;
	HAL_UART_Receive_DMA(&huart3, UART3_RX, 4);


  //DONE
	if(Eva.AttackMode != MICROMOUSE)
	{
	  ssd1306_Clear();
	  _ssd1306_WriteInTheMiddle("EVANGELION", 0, BIG);
	  _ssd1306_WriteInTheMiddle("DONE", 22, SMALL);
	  ssd1306_UpdateScreen();
	}

  PLAY_FREQ(0);

  //Afterparty changes
  Eva.Accel.x = 0;
  Eva.Accel.y = 0;
  Eva.Accel.z = 0;
  Eva.Accel.peak = 0;
  Eva.Gyro.x = 0;
  Eva.Gyro.y = 0;
  Eva.Gyro.z = 0;
  Eva.Gyro.peak = 0;

  if(Eva.AttackMode == MICROMOUSE)
	  ARDUINO_INIT();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  while (1)
  {

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

