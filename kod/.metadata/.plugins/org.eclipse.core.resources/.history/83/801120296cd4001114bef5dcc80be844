			}
			else if(currentAction == UP && depth == 1)
			{
				option = (option - 1 ) % 3;
				currentAction = NOTHING;
			}
			else if(currentAction == DOWN && depth == 1)
			{
				option = (option + 1 ) % 3;
				currentAction = NOTHING;
			}
			else if(currentAction == UP && depth == 2)
			{
				StartMod.Delay = StartMod.Delay + 100;
				currentAction = NOTHING;
			}
			else if(currentAction == DOWN && depth == 2)
			{
				if(StartMod.Delay - START_MOD_ID_OPTIONS_START_DELAY_STEP >= 0)
				{
					StartMod.Delay = StartMod.Delay - START_MOD_ID_OPTIONS_START_DELAY_STEP;
				}
				else
				{
					StartMod.Delay = 0;
				}
				currentAction = NOTHING;
			}
			else if(currentAction == CANCEL && depth == 2)
			{
				depth = 1;
				currentAction = NOTHING;
			}
			else if(currentAction == CANCEL)
			{
				depth = 0;
				option = 1;
				currentAction = NOTHING;
			}
		}

	}
	else if(MENU_OPTION_LIST[Eva.Interface.MenuOption].id == OPTION_ID_IMU_PEAK)
	{

		_ssd1306_SetCursor(HOW_FAR_SECOND_COLUMN, 2);
