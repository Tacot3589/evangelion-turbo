void PLAY_FREQ(uint16_t f_hz)
{
	f_hz = f_hz * (Settings.ENABLE_BUZZER==0);
    if (f_hz == 0) {
        __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, 0);
        return;
    }

    // Stały PSC=169 -> licznik 1 MHz (TIMCLK 170 MHz / (169+1))
    __HAL_TIM_SET_PRESCALER(&htim3, 169);

    uint32_t arr = 1000000UL / f_hz;            // okres w tickach 1 MHz
    if (arr == 0) arr = 1;                      // minimalna wartość
    arr -= 1;                                   // rejestrowo

    __HAL_TIM_DISABLE(&htim3);
    __HAL_TIM_SET_AUTORELOAD(&htim3, (uint16_t)arr);
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, (uint16_t)(((arr + 1U) >> 1)));
    __HAL_TIM_SET_COUNTER(&htim3, 0);
    __HAL_TIM_ENABLE(&htim3);
    HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_4);
}

void _ssd1306_WriteInTheMiddle(char *text, uint8_t y, uint8_t font)
{
	int8_t x;
	uint8_t textSize = strlen(text);

	if(font == BIG)
	{
		x = (int)(128 - textSize*11)/2;
		if(x < 0)
		{
			text="ERR LENGHT";
			x = 0;
		}
		_ssd1306_SetCursor(x, y);
		ssd1306_WriteString(text, Font_11x18);
	}
	else if(font == SMALL) //max 21chars
	{
		x = (int)(128 - textSize*6)/2;
		if(x < 0)
		{
			text="ERR LENGHT";
			x = 0;
		}
		_ssd1306_SetCursor(x, y);
		ssd1306_WriteString(text, Font_6x8);
	}

}


