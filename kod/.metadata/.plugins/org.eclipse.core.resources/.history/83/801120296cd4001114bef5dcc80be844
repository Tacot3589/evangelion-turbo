void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
  //TODO windowsDIst1 i windwosdist2 musi by XDDDD
  uint16_t buffor_Dist[LIDARS_FILTERING_ARRAY_SIZE];
  uint16_t buffor_Amp[LIDARS_FILTERING_ARRAY_SIZE];
  uint16_t Dist, Temp, Amp;
  uint8_t j, k;

	if(huart->Instance == USART1)
	{
		for (int i = 1; i < 10; i++)
		{
			if (UART1_RX[(i-1)% 9] == 0x59 && UART1_RX[i%9] == 0x59)
			{
				//DISTANCE
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Dist = UART1_RX[j] + (UART1_RX[k] << 8);


				//AMPERAGE
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Amp = UART1_RX[j] + (UART1_RX[k] << 8);

				//TEMPERATURE
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temp = UART1_RX[j] + (UART1_RX[k] << 8);

				if(Amp < MIN_AMP_TRESCHOLD)
				{
					Dist = 65000;
				}

				break;
			}
		}

	//=====MEDIAN FILTERING
	static uint16_t window1_Dist[LIDARS_FILTERING_ARRAY_SIZE] = {2000};
    static uint16_t window1_Amp[LIDARS_FILTERING_ARRAY_SIZE] = {200};
    static uint8_t idx1_Dist = 0;
    static uint8_t idx1_Amp = 0;

	//Wstaw nowe wartosci
	window1_Dist[idx1_Dist] = Dist;
	window1_Amp[idx1_Amp] = Amp;

	//Przesun indeksy cyklicznie
	idx1_Dist = (idx1_Dist + 1) % LIDARS_FILTERING_ARRAY_SIZE;
	idx1_Amp = (idx1_Amp + 1) % LIDARS_FILTERING_ARRAY_SIZE;

    //Kopiuj i sortuj w jednej petli
    for (int i = 0; i < LIDARS_FILTERING_ARRAY_SIZE; i++) {
        buffor_Dist[i] = window1_Dist[i];
        buffor_Amp[i] = window1_Amp[i];
    }

    //Sortuj osobno
    SORT(buffor_Dist, LIDARS_FILTERING_ARRAY_SIZE);
    SORT(buffor_Amp, LIDARS_FILTERING_ARRAY_SIZE);

    //Wyciagnij mediany
    Dist = buffor_Dist[(uint8_t)((LIDARS_FILTERING_ARRAY_SIZE - 1) / 2)];
    Amp = buffor_Amp[(uint8_t)((LIDARS_FILTERING_ARRAY_SIZE - 1) / 2)];

		//Save results
		if(SWITCH_LIDARS)
		{
			Right.Distance = Dist;
			Right.LidarAmp = Amp;
			Right.LidarTemp = Temp;
		}
		else
		{
			Left.Distance = Dist;
			Left.LidarAmp = Amp;
			Left.LidarTemp = Temp;
		}
	}


	if(huart->Instance == USART2)
	{
		for (int i = 1; i < 10; i++)
		{
			if (UART2_RX[(i-1)%9] == 0x59 && UART2_RX[i%9] == 0x59)
			{
				//DISTANCE
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Dist = UART2_RX[j] + (UART2_RX[k] << 8);

				//AMPERAGE
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Amp = UART2_RX[j] + (UART2_RX[k] << 8);

				//TEMPERATURE
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temp = UART2_RX[j] + (UART2_RX[k] << 8);

				if(Amp < MIN_AMP_TRESCHOLD)
				{
					Dist = 65000;
				}

				break;
			}
		}

		//=====MEDIAN FILTERING
	static uint16_t window2_Dist[LIDARS_FILTERING_ARRAY_SIZE] = {0};
    static uint16_t window2_Amp[LIDARS_FILTERING_ARRAY_SIZE] = {0};
    static uint8_t idx2_Dist = 0;
    static uint8_t idx2_Amp = 0;


	//Wstaw nowe wartosci
	window2_Dist[idx2_Dist] = Dist;
	window2_Amp[idx2_Amp] = Amp;

	//Przesun indeksy cyklicznie
	idx2_Dist = (idx2_Dist + 1) % LIDARS_FILTERING_ARRAY_SIZE;
	idx2_Amp = (idx2_Amp + 1) % LIDARS_FILTERING_ARRAY_SIZE;


    //Kopiuj i sortuj w jednej petli
    for (int i = 0; i < LIDARS_FILTERING_ARRAY_SIZE; i++) {
        buffor_Dist[i] = window2_Dist[i];
        buffor_Amp[i] = window2_Amp[i];
    }

    //Sortuj osobno
    SORT(buffor_Dist, LIDARS_FILTERING_ARRAY_SIZE);
    SORT(buffor_Amp, LIDARS_FILTERING_ARRAY_SIZE);

    //Wyciagnij mediany
    Dist = buffor_Dist[(uint8_t)((LIDARS_FILTERING_ARRAY_SIZE - 1) / 2)];
    Amp = buffor_Amp[(uint8_t)((LIDARS_FILTERING_ARRAY_SIZE - 1) / 2)];

		//Save results
		if(SWITCH_LIDARS)
		{
			Left.Distance = Dist;
			Left.LidarAmp = Amp;
			Left.LidarTemp = Temp;
		}
		else
		{
			Right.Distance = Dist;
			Right.LidarAmp = Amp;
			Right.LidarTemp = Temp;
		}
	}
