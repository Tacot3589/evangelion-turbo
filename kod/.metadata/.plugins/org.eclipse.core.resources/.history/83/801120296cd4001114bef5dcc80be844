void SET_MOTORS(int8_t l, int8_t r)
{

	//utils
	if(Settings.DONT_USE_MOTORS)
		l = r = 0;

	if (SWITCH_MOTORS)
	{
	    int8_t tmp = l;
	    l = r;
	    r = tmp;
	}


	if(r != 0)
		r = Acceleration_Compensation_R(r);
	if(l != 0)
		l = Acceleration_Compensation_L(l);


	if(REVERSE_RIGHT_MOTOR)
	{
		r = -r;
	}
	if(REVERSE_LEFT_MOTOR)
	{
		l = -l;
	}
	//sets
	//SET PWMs
	if(l == 0)
	{
		TIM2->CCR1 = 1; //L front
		TIM2->CCR2 = 1; //L back
	}
	else if(l > 0)
	{
		l = (uint8_t)(REAL_MIN_PWM_PERCENTAGE + (l * (REAL_MAX_PWM_PERCENTAGE - REAL_MIN_PWM_PERCENTAGE)) / 100);
		dupa = l;
		TIM2->CCR1 = l; //L front
		TIM2->CCR2 = 1; //L back
	}
	else
	{
		l = (uint8_t)(REAL_MIN_PWM_PERCENTAGE + (-l * (REAL_MAX_PWM_PERCENTAGE - REAL_MIN_PWM_PERCENTAGE)) / 100);

		TIM2->CCR1 = 1; //L front
		TIM2->CCR2 = l; //L back
	}

	//SET PWMs
	if(r == 0)
	{
		TIM2->CCR3 = 1; //R front
		TIM2->CCR4 = 1; //R back
	}
	else if(r > 0)
	{
		r = (uint8_t)(REAL_MIN_PWM_PERCENTAGE + (r * (REAL_MAX_PWM_PERCENTAGE - REAL_MIN_PWM_PERCENTAGE)) / 100);

		TIM2->CCR3 = r; //R front
		TIM2->CCR4 = 1; //R back
	}
	else
	{
		r = (uint8_t)(REAL_MIN_PWM_PERCENTAGE + (-r * (REAL_MAX_PWM_PERCENTAGE - REAL_MIN_PWM_PERCENTAGE)) / 100);

		TIM2->CCR3 = 1; //R front
		TIM2->CCR4 = r; //R back
	}
}


