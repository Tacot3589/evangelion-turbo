#include "ADC_READOUT.h"
#include "main.h"
#include "MY_INCLUDES.h"


void ADC_REDOUT_INFO_GETTHEMALL(Evangelion_t *Eva, MotorsSettingsInfo_t *Motors, LinesSensors_t  *Lines, volatile uint16_t *A1, volatile uint16_t *A2)
{
	Lines->FrontLeft.RawA = A2[1-1];
	Lines->FrontLeft.RawB = A2[2-1];

	Lines->FrontRight.RawA = A1[2-1];
	Lines->FrontRight.RawB = A2[5-1];

	Lines->BackLeft.RawA = A2[3-1];
	Lines->BackLeft.RawB = A1[5-1];

	Lines->BackRight.RawA = A1[4-1];
	Lines->BackRight.RawB = A2[4-1];

	//================================ MEDIAN FILTERING, vbat
	static uint16_t VBAT_FILTER_ARRAY[BATTERY_ADC_VOLTAGE_FILTRATION_ARRAY_SIZE];
	static uint16_t VBAT_FILTER_INDX=0;
	static uint16_t CURRENT_VBAT=0;

	CURRENT_VBAT = BATTERY_CONST * A2[6-1];
	VBAT_FILTER_ARRAY[VBAT_FILTER_INDX] = CURRENT_VBAT;
	VBAT_FILTER_INDX = (VBAT_FILTER_INDX + 1) % BATTERY_ADC_VOLTAGE_FILTRATION_ARRAY_SIZE;

	Eva->Voltage = GET_MEDIAN(VBAT_FILTER_ARRAY, BATTERY_ADC_VOLTAGE_FILTRATION_ARRAY_SIZE);

	//================================ MEDIAN FILTERING, MCU temp
	static uint16_t MCU_TEMP_FILTER_ARRAY[MCU_TEMP_FILTRATION_ARRAY_SIZE];
	static uint16_t MCU_TEMP_FILTER_INDX=0;
	static uint16_t CURRENT_MCU_TEMP=0;

	CURRENT_MCU_TEMP = __LL_ADC_CALC_TEMPERATURE(REFERENCE_VOLTAGE*1000, A1[6-1], LL_ADC_RESOLUTION_12B);
	MCU_TEMP_FILTER_ARRAY[MCU_TEMP_FILTER_INDX] = CURRENT_MCU_TEMP;
	MCU_TEMP_FILTER_INDX = (MCU_TEMP_FILTER_INDX + 1) % MCU_TEMP_FILTRATION_ARRAY_SIZE;

	Eva->MCU_TEMP = GET_MEDIAN(MCU_TEMP_FILTER_ARRAY, MCU_TEMP_FILTRATION_ARRAY_SIZE);

	//================================ MEDIAN FILTERING, DRV_CURRENT_1
	static uint16_t DRVL_FILTER_ARRAY[DRV_CURRENT_FILTRATION_ARRAY_SIZE];
	static uint16_t DRVL_FILTER_INDX=0;
	static uint16_t CURRENT_DRVL=0;

	CURRENT_DRVL = A1[3-1] * DRV8873_CURERNT_CONST;
	DRVL_FILTER_ARRAY[DRVL_FILTER_INDX] = CURRENT_DRVL;
	DRVL_FILTER_INDX = (DRVL_FILTER_INDX + 1) % DRV_CURRENT_FILTRATION_ARRAY_SIZE;

	Motors->DRV_Current.L = GET_MEDIAN(DRVL_FILTER_ARRAY, DRV_CURRENT_FILTRATION_ARRAY_SIZE);

	//================================ MEDIAN FILTERING, DRV_CURRENT_2
	static uint16_t DRVR_FILTER_ARRAY[DRV_CURRENT_FILTRATION_ARRAY_SIZE];
	static uint16_t DRVR_FILTER_INDX=0;
	static uint16_t CURRENT_DRVR=0;

	CURRENT_DRVR = A1[1-1] * DRV8873_CURERNT_CONST;
	DRVR_FILTER_ARRAY[DRVR_FILTER_INDX] = CURRENT_DRVR;
	DRVR_FILTER_INDX = (DRVR_FILTER_INDX + 1) % DRV_CURRENT_FILTRATION_ARRAY_SIZE;

	Motors->DRV_Current.R = GET_MEDIAN(DRVR_FILTER_ARRAY, DRV_CURRENT_FILTRATION_ARRAY_SIZE);
}

uint8_t ADC_READOUT_INIT(ADC_HandleTypeDef *hadc, volatile uint16_t *Array, uint16_t Size)
{
	if (HAL_ADCEx_Calibration_Start(hadc, ADC_SINGLE_ENDED) != HAL_OK)
		return 1;
	HAL_Delay(10);

	if (HAL_ADC_Start_DMA(hadc, (uint32_t*)Array, Size) != HAL_OK)
		return 1;
	HAL_Delay(10);

	return 0;
}








