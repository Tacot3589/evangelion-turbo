#include "start_module.h"
#include "main.h"
#include "MY_INCLUDES.h"

static uint8_t StartModuleStarted = false;
static static uint8_t Dohyo_ID=0;
static StartMod_state_t Module_State = STARTUP;

uint8_t StartModule_Startup()
{
    Module_State = STARTUP;
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("START", init_text_height, BIG);
	_ssd1306_WriteInTheMiddle("MODULE", init_secondary_text_height, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(init_everywhere_delay);
	//  Signal Power UP
	HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, GPIO_PIN_SET);
	HAL_Delay(125);
	HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_BLUE_GPIO_Port, LED_BLUE_Pin, GPIO_PIN_SET);
	HAL_Delay(125);
	HAL_GPIO_WritePin(LED_BLUE_GPIO_Port, LED_BLUE_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, GPIO_PIN_SET);
	HAL_Delay(250);
	HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, GPIO_PIN_RESET);
}
