uint8_t TFLUNAs_INIT(LineSensors_t Lunas)
{

	//disable interrupts, start dma
    if (HAL_UARTEx_ReceiveToIdle_DMA(Lunas.FrontRight.huartRX, Lunas.FrontRight.RX, sizeof RX1) != HAL_OK) {
        return 1;
    }
    __HAL_DMA_DISABLE_IT(huartRX1->hdmarx, DMA_IT_HT);

    if (HAL_UARTEx_ReceiveToIdle_DMA(huartRX2, RX2, sizeof RX2) != HAL_OK) {
        return 2;
    }
    __HAL_DMA_DISABLE_IT(huartRX3->hdmarx, DMA_IT_HT);

    if (HAL_UARTEx_ReceiveToIdle_DMA(huartRX3, RX3, sizeof RX3) != HAL_OK) {
        return 3;
    }
    __HAL_DMA_DISABLE_IT(huartRX4->hdmarx, DMA_IT_HT);

    if (HAL_UARTEx_ReceiveToIdle_DMA(huartRX4, RX4, sizeof RX4) != HAL_OK) {
        return 4;
    }
    __HAL_DMA_DISABLE_IT(huartRX4->hdmarx, DMA_IT_HT);


    //Send command
	if(HAL_UART_Transmit(&huartTX, (uint8_t *)CMD_DISABLE_OUTPUT, sizeof(CMD_DISABLE_OUTPUT), INIT_TIMEOUT) != HAL_OK)
		return 1;

	//Wait for success
	uint32_t start = HAL_GetTick();
	while (true)
	{
		if(((ack1 == 1) && (ack2 == 1) && (ack3 == 1) && (ack4 == 1)))
		{
			break;
		}

		else if( (HAL_GetTick() - start) <(INIT_TIMEOUT*4) )
		{
			return 5;
		}
	}



/*
	HAL_UART_AbortReceive(huartRX);
	__HAL_UART_CLEAR_OREFLAG(huartRX);
	huartRX->ErrorCode = HAL_UART_ERROR_NONE;
	huartRX->RxState   = HAL_UART_STATE_READY;
	huartRX->gState = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(huartRX, RX, 9) != HAL_OK)
		return 1;
	__HAL_DMA_DISABLE_IT(hdma, DMA_IT_HT);
*/
	return HAL_OK;
}


void TFLUNAs_DMA_CALLBACK(UART_HandleTypeDef *huartRX1, UART_HandleTypeDef *huartRX2, UART_HandleTypeDef *huartRX3, UART_HandleTypeDef *huartRX4,
		, volatile uint8_t *RX1, volatile uint8_t *RX2, volatile uint8_t *RX3, volatile uint8_t *RX4)
{
	if(IN_INIT == true)
	{
	    if (huart->Instance == huartRX1)
	    {
	        buffer = rx1_dma;
	        parser = &parser1;
	        ack = &ack1;
	    } else if (huart->Instance == huartRX2)
	    {
			buffer = rx2_dma;
			parser = &parser2;
			ack = &ack2;
		}else if (huart->Instance == huartRX3)
		{
	        buffer = rx3_dma;
	        parser = &parser3;
	        ack = &ack3;
	    } else if (huart->Instance == huartRX4)
	    {
	        buffer = rx4_dma;
	        parser = &parser4;
	        ack = &ack4;
	    } else {
	        return;
	    }

	    for (uint16_t i = 0; i < size; i++) {
	        AckParser_Push(parser, buffer[i], ack);
	    }

	    // DMA w trybie Normal trzeba uzbroić ponownie po każdym zdarzeniu.
	    if (HAL_UARTEx_ReceiveToIdle_DMA(huart, buffer, LUNA_DMA_SIZE) == HAL_OK) {
	        __HAL_DMA_DISABLE_IT(huart->hdmarx, DMA_IT_HT);
	    }
	}
}

uint8_t BUFFER_CONTAINS(const uint8_t *buffer, const uint8_t *pattern)
{
	size_t buffer_len = sizeof buffer;
	size_t pattern_len = sizeof pattern;

    if (buffer == NULL || pattern == NULL || pattern_len == 0 || pattern_len > buffer_len) {
        return false;
    }

    for (size_t i = 0; i <= buffer_len - pattern_len; i++)
    {
        size_t j = 0;

        while (j < pattern_len && buffer[i + j] == pattern[j]) {
            j++;
        }

        if (j == pattern_len) {
            return true;
        }
    }

    return false;
}
