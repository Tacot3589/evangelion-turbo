#include "DRIVERS.h"
#include "main.h"
#include "MY_INCLUDES.h"

uint8_t BUFFER[20];

uint8_t DRIVERS_INIT(SPI_HandleTypeDef *hspi)
{
	  HAL_GPIO_WritePin(DRV_CS_1_GPIO_Port, DRV_CS_1_Pin, 0);
	  HAL_GPIO_WritePin(DRV_CS_2_GPIO_Port, DRV_CS_2_Pin, 1);


	  HAL_SPI_TransmitReceive(hspi, 0x00, BUFFER, 8, 500);

	  return 0;
}







