#include "ATCK_MODES.h"
#include "main.h"
#include "MY_INCLUDES.h"



Velocity_t STRAIGHT_SIMPLEST_ATTACK()
{
	Velocity_t V;
	if(Lunas.FrontLeft.Dist < 20 && Lunas.FrontRight.Dist < 20)
	{
		V.L = 300;
		V.R = 300;
	}
	else
	{
		V.L = 0;
		V.R = 0;
	}
	return V;
}
