void SaveToFlash(uint8_t Protocol, uint8_t Addres, uint8_t Status)
{
	// Disable all interrupts timers
	uint32_t flash_address_configuration;
	uint64_t data;
	uint32_t flash_buffer = 0x00000000;

	data = 0;

	if (Protocol == RC5)
	{
		// PREPARE DATA TO WRITE
		flash_buffer = ReadFromFlash(SIRC);
		data = Addres << 11;
		data = data + (flash_buffer << 3);
		data = data + Status;
	}
	else if (Protocol == SIRC)
	{
		flash_buffer = ReadFromFlash(RC5);
		data = flash_buffer << 11;
		data = data + (Addres << 3);
		data = data + Status;
	}

	// CHECK IF ALL MEMORY IS USED
	flash_address_configuration = FLASHADDR + FLASHRANGE;
	flash_buffer = *(__IO uint32_t *)flash_address_configuration;

	// IF ALL MEMORY IS USED ERASE SECTOR AND WRITE DATA IN FIRST ADDRES
	if (flash_buffer != 0xFFFFFFFF)
	{
		HAL_FLASH_Unlock();
		FLASH_EraseInitTypeDef EraseInitStruct;
		EraseInitStruct.TypeErase = FLASH_TYPEERASE_PAGES;
		EraseInitStruct.Page = 14;
		EraseInitStruct.NbPages = 2;
		uint32_t PageError;

		HAL_FLASHEx_Erase(&EraseInitStruct, &PageError);
		volatile int d=48000; while(d>0) { d--; }
//		HAL_Delay(1000);

		flash_address_configuration = FLASHADDR;
		HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, flash_address_configuration, data);
//		d=48000; while(d>0) { d--; }
		HAL_FLASH_Lock();
	}
	// IF NOT ALL MEMORY IS USED WRITE DATA IN FIRST EMPTY ADDRES
	else
	{
		flash_address_configuration = FLASHADDR;
		flash_buffer = *(__IO uint32_t *)flash_address_configuration;
		while (flash_buffer != 0xFFFFFFFF)
		{
			flash_address_configuration = flash_address_configuration + 8;
			flash_buffer = *(__IO uint32_t *)flash_address_configuration;
		}
		HAL_FLASH_Unlock();
		HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, flash_address_configuration, data);
		HAL_FLASH_Lock();

	}
}

uint8_t ReadFromFlash(uint8_t Data)
{
	uint32_t 	flashAddress;
	uint32_t 	flash_buffer;
	uint8_t		RC5_Address;
	uint8_t		SIRC_Address;
	uint8_t		Saved_Status;
	uint8_t 	Readback;


	flashAddress = FLASHADDR;
	flash_buffer = *(__IO uint32_t *)flashAddress;
	while (flash_buffer != 0xFFFFFFFF)
	{
		flashAddress = flashAddress + 8;
		flash_buffer = *(__IO uint32_t *)flashAddress;
	}
	flashAddress = flashAddress - 8;
	flash_buffer = *(__IO uint32_t *)flashAddress;

	Saved_Status = 0;
	Saved_Status = flash_buffer;
	RC5_Address = flash_buffer >> 11;
	SIRC_Address = flash_buffer >> 3;

	if (Data == RC5)
		Readback = RC5_Address & 0b00011111;
	else if (Data == SIRC)
		Readback = SIRC_Address & 0b00011111;
	else if (Data == SAVED_STATUS)
		Readback = Saved_Status & 0b00000111;
	else
		Readback = 0;

//	RC5_ADDRS = Readback = RC5_Address & 0b00011111;
//	SIRC_ADDRS = Readback = SIRC_Address & 0b00011111;
//	Module_State = Saved_Status & 0b00000111;

	return Readback;
}


