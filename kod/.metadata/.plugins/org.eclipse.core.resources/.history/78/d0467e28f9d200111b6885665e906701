#include "ADC_READOUT.h"
#include "main.h"
#include "MY_INCLUDES.h"


void ADC_REDOUT_INFO_GETTHEMALL(Evangelion_t *Eva, LinesSensors_t *Lines, uint8_t *A1, uint8_t *A2)
{
	Eva->Voltage = BATTERY_CONSTANT * A2[1];

	Lines->FrontLeft.RawA = A2[0];
	Lines->FrontLeft.RawB = A2[1];

	Lines->FrontRight.RawA = A1[1];
	Lines->FrontRight.RawB = A1[2];

	Lines->BackLeft.RawA = A2[1];
	Lines->BackLeft.RawB = A2[2];

	Lines->BackRight.RawA = A1[1];
	Lines->BackRight.RawB = A1[2];

}
