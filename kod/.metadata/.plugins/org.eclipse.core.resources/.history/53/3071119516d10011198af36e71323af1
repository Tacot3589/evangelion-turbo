#include "start_module.h"
#include "main.h"
#include "MY_INCLUDES.h"

static uint8_t UART_TX[8];

uint8_t TFLUNA_INIT(UART_HandleTypeDef *huartRX, UART_HandleTypeDef *huartTX, DMA_HandleTypeDef *hdma, uint8_t *RX)
{
	uint8_t counter=0;

	//LIDARS OFF
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x00;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huartTX, UART_TX, 5, INIT_TIMEOUT);
		HAL_UART_Receive(huartRX, RX, 5, INIT_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_INIT)
			return 1;
		counter++;
	}
	counter=0;
	HAL_Delay(50);


	//LIDARS SET 250Hz
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x06;
	UART_TX[2] = 0x03;
	UART_TX[3] = 0xFA;
	UART_TX[4] = 0x00;
	UART_TX[5] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huartTX, UART_TX, 6, INIT_TIMEOUT);
		HAL_UART_Receive(huartRX, RX, 6, INIT_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			return 1;
		counter++;
	}
	counter=0;
	HAL_Delay(50);



	//LIDARS ON
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x01;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huartTX, UART_TX, 5, INIT_TIMEOUT);
		HAL_UART_Receive(huartRX, RX, 5, INIT_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			return 1;
		counter++;
	}
	HAL_Delay(50);


	counter=0;
	while(true)
	{

		if(huart->RxState == HAL_UART_STATE_READY && huart->gState == HAL_UART_STATE_READY && huart->ErrorCode == HAL_UART_ERROR_NONE)
			break;
		else if(counter >= MAX_RETRIES_LIDARS_INIT)
			return 1;

		HAL_Delay(INIT_TIMEOUT);
		counter++;
	}

	HAL_Delay(50);


	HAL_UART_AbortReceive(huart);
	__HAL_UART_CLEAR_OREFLAG(huart);
	huart->ErrorCode = HAL_UART_ERROR_NONE;
	huart->RxState   = HAL_UART_STATE_READY;
	huart->gState = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(huart, RX, 9) != HAL_OK)
		COOKED(LIDARS_INIT_ERR);
	__HAL_DMA_DISABLE_IT(hdma, DMA_IT_HT);
}
