void Watchdog_100HZ(void)
{
	static 	uint16_t 	Timer;
	static 	uint8_t 	LastStartState;
	static 	uint8_t 	LastStartModState;
	static 	uint8_t		Was_Started;
	static 	uint8_t 	Start_System;
	static	uint8_t		Combat_Toggle;

	if (Timer % 100 == 0)
		HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin);

	Supply_Voltage 		= 	ADC_readout[ADC_CHANNEL_BATTERY_VOLTAGE] * Voltage_Calculation_Constant;
	Start_Status 		= 	HAL_GPIO_ReadPin(START_GPIO_Port, START_Pin);
	Start_Module_Status = 	HAL_GPIO_ReadPin(STARTMOD_GPIO_Port, STARTMOD_Pin);
//	Start_Module_Status = 	0;
	Module_Switch[0]	=	HAL_GPIO_ReadPin(SW1_GPIO_Port, SW1_Pin);
	Module_Switch[1]	=	HAL_GPIO_ReadPin(SW2_GPIO_Port, SW2_Pin);

	BATTERY_UndervoltageProtection(Battery_Type);

	if (Start_System == DEFAULT || Start_System == MODULE)
	{
		if (Start_Module_Status == 1 && LastStartModState == 0)
		{
			HAL_TIM_Base_Start_IT(&htim7);
			Start_System = MODULE;
			Was_Started = 1;
		}
		if (Start_Module_Status == 0 && Was_Started == 1)
		{
			HAL_TIM_Base_Stop_IT(&htim7); 												// Stop Main Program
			HAL_GPIO_WritePin(Motor_KILL_GPIO_Port, Motor_KILL_Pin, GPIO_PIN_RESET);	// Cut power to the motors
			HAL_GPIO_WritePin(EN_5V_GPIO_Port, EN_5V_Pin, GPIO_PIN_SET);				// Disable power to sensors
			MOTOR_DRIVER_SetDuty(BOTH_MOTORS, 0);
			CAN_TX[3] = 0x00;
			MOTOR_DRIVER_TransmitData();
		}
	}

	if (Start_System == DEFAULT || Start_System == BUTTON)
	{
		if (Start_Status == 1 && LastStartState == 0)
		{
			HAL_TIM_Base_Start_IT(&htim7);
			Start_System = BUTTON;
		}
		if (Start_Status == 0 && LastStartState == 1)
		{
			HAL_TIM_Base_Stop_IT(&htim7); 												// Stop Main Program
			HAL_GPIO_WritePin(Motor_KILL_GPIO_Port, Motor_KILL_Pin, GPIO_PIN_RESET);	// Cut power to the motors
			HAL_GPIO_WritePin(EN_5V_GPIO_Port, EN_5V_Pin, GPIO_PIN_SET);				// Disable power to sensors
			MOTOR_DRIVER_SetDuty(BOTH_MOTORS, 0);
			CAN_TX[3] = 0x00;
			MOTOR_DRIVER_TransmitData();
		}
	}
	if (Start_Status == 0 && Start_Module_Status == 0)
	{
//		MOTOR_DRIVER_SetDuty(BOTH_MOTORS, 10);
//		HAL_TIM_Base_Stop_IT(&htim7);
		CAN_TX[0] = 0x01;
		CAN_TX[1] = 0x00;
		CAN_TX[2] = 0x00;
		CAN_TX[3] = 0x00;
		CAN_TX[4] = 0x00;
		CAN_TX[5] = 0x00;
		CAN_TX[6] = 0x00;
		CAN_TX[7] = 0x00;
		MOTOR_DRIVER_TransmitData();
		CAN_TX[0] = 0x51;
		CAN_TX[1] = 0x00;
		CAN_TX[2] = 0x00;
		CAN_TX[3] = 0x00;
		MOTOR_DRIVER_TransmitData();

		SUMO_PreStartParameters();
		// allow for combat mode selection
		if (Module_Switch[1] == 0 && Module_Switch[0] == 0 && Combat_mode != SUMO)
		{
			Combat_mode = SUMO;
			// set motor Current limits
			CAN_TX[0] = 0x13;
			CAN_TX[1] = SUMO_MOTOR_MAX_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;

			//	 set motor constant current limits
			CAN_TX[0] = 0x14;
			CAN_TX[1] = SUMO_MOTOR_MAX_CONSTANT_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x14 && CAN_RX[5] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;
		}
		else if (Module_Switch[1] == 1 && Module_Switch[0] == 0 && Combat_mode != MEGA_SUMO && ROBOT == HIROSHIMA)
		{
			Combat_mode = MEGA_SUMO;
			// set motor Current limits
			CAN_TX[0] = 0x13;
			CAN_TX[1] = SUMO_MOTOR_MAX_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;

			//	 set motor constant current limits
			CAN_TX[0] = 0x14;
			CAN_TX[1] = SUMO_MOTOR_MAX_CONSTANT_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x14 && CAN_RX[5] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;
		}
		if (Module_Switch[1] == 0 && Module_Switch[0] == 1 && Combat_mode != MICROMAUSE)
		{
			Combat_mode = MICROMAUSE;
			// set motor Current limits
			CAN_TX[0] = 0x13;
			CAN_TX[1] = SUMO_MOTOR_MAX_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;

			//	 set motor constant current limits
			CAN_TX[0] = 0x14;
			CAN_TX[1] = SUMO_MOTOR_MAX_CONSTANT_CURRENT;
			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
//			if (CAN_RX[0] != 0x14 && CAN_RX[5] != CAN_TX[1])
//				MOTOR_DRIVER_INIT_FLAG = ERROR;
		}

		Combat_Toggle = Combat_mode;
	}
	// Execute motor driver resync:
	if (MOTOR_DRIVER_TIMEOUT >= MOTOR_TIMEOUT)
	{
		MOTOR_DRIVER_INIT_FLAG = DESYNCED;
		MOTOR_DRIVER_TIMEOUT = 0;
	}
	// Iterate motor driver timeout flag
	if (MOTOR_DRIVER_INIT_FLAG == SYNCED)
	{
		MOTOR_DRIVER_TIMEOUT++;
		HAL_GPIO_WritePin(Motor_KILL_GPIO_Port, Motor_KILL_Pin, GPIO_PIN_SET);
	}
	else if (MOTOR_DRIVER_INIT_FLAG == DESYNCED)
	{
		HAL_GPIO_WritePin(Motor_KILL_GPIO_Port, Motor_KILL_Pin, GPIO_PIN_RESET);
	}


	LastStartState 		= Start_Status;
	LastStartModState 	= Start_Module_Status;
	Timer++;
	Timer 				= Timer % 1000;

}

