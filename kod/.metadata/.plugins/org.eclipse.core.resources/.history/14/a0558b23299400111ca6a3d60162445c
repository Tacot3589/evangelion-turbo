/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM6_Init();
  MX_TIM7_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_ADC2_Init();
  MX_I2C1_Init();
  MX_FDCAN1_Init();
  MX_TIM16_Init();
  MX_TIM17_Init();
  MX_I2C2_Init();
  MX_LPUART1_UART_Init();
  /* USER CODE BEGIN 2 */

  HAL_Delay(50);
//  HAL_GPIO_WritePin(LED1_GPIO_Port, LED1_Pin, GPIO_PIN_SET);
  ssd1306_Init();
  ssd1306_Clear();
  ssd1306_SetColor(White);
  ssd1306_FlipScreenVertically();

  ssd1306_SetCursor(25, 30);
  ssd1306_WriteString("ROBOILO", Font_11x18);
  ssd1306_UpdateScreen();

  OLED_SendInitializeMessage("ADC Calibration  ");
  Voltage_Calculation_Constant = (float)VOLTAGE_3V3 / (float)4096.0;
  Voltage_Calculation_Constant = Voltage_Calculation_Constant * (VCC_RESITOR + GND_RESISTOR);
  Voltage_Calculation_Constant = Voltage_Calculation_Constant / (float)GND_RESISTOR;
  Voltage_Calculation_Constant = Voltage_Calculation_Constant / 1000;


  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK)
 	  Error_Handler();
  if (HAL_ADCEx_Calibration_Start(&hadc2, ADC_SINGLE_ENDED) != HAL_OK)
	  Error_Handler();


//  OLED_SendInitializeMessage("   ADC Start      ");
  if (HAL_ADC_Start_DMA(&hadc1, ADC_readout, 8) != HAL_OK)
	  Error_Handler();
  if (HAL_ADC_Start_DMA(&hadc2, ADC_readout+8, 6) != HAL_OK)
	  Error_Handler();
  HAL_Delay(50);

  // Select Robot
  ROBOT = SelectRobot();
  OLED_DisplayRobotName(ROBOT);

  HAL_Delay(1000);

  ssd1306_Clear();
  ssd1306_SetCursor(25, 5);
  ssd1306_WriteString("STARTUP", Font_11x18);
  ssd1306_UpdateScreen();

  Supply_Voltage = ADC_readout[ADC_CHANNEL_BATTERY_VOLTAGE] * Voltage_Calculation_Constant;
  OLED_SendInitializeMessage("Checking Battery   ");
  Battery_Type = BATTERY_SelectType();

  // Initialize LIDAR Sensors
  OLED_SendInitializeMessage(" Lidars Startup    ");
  //Enable Lidars Power
  HAL_GPIO_WritePin(EN_5V_GPIO_Port, EN_5V_Pin, GPIO_PIN_RESET);
  HAL_Delay(700);

  if (ROBOT == HIROSHIMA || ROBOT == HIROSHIMKA || ROBOT == BABY_HIROSHIMA || ROBOT == BABY_HIROSHIMKA || ROBOT == KAMA || ROBOT == BABY_KAMA)
  {
	  TF_MINI_Init(TF_FL);
	  TF_MINI_Init(TF_FR);
  }
  if (ROBOT == HIROSHIMA || ROBOT == HIROSHIMKA)
  {
	  TF_MINI_Init(TF_AL);
	  TF_MINI_Init(TF_AR);
  }

  HAL_Delay(10);

  // USE if connecting brand new sensor to configure parameters
// DUPA = TF_MINI_Config(TF_AL);
// DUPA = TF_MINI_Config(TF_AR);
// DUPA = TF_MINI_Config(TF_FL);
// DUPA = TF_MINI_Config(TF_FR);


  if (FRONT_LEFT_Distance == 0 && FRONT_LEFT_Return == 0 && FRONT_LEFT_Temperature == 0 )
  {
	  OLED_SendInitializeMessage(" Lidar L FAILED    ");
	  Error_Handler();
  }
  if (FRONT_RIGHT_Distance == 0 && FRONT_RIGHT_Return == 0 && FRONT_RIGHT_Temperature == 0)
  {
	  OLED_SendInitializeMessage(" Lidar R FAILED    ");
	  Error_Handler();
  }

  //Initialize IMU
  OLED_SendInitializeMessage("   IMU Init     ");
  ACC_Init();
  HAL_Delay(100);
  if (A_X == 0 && A_Y == 0 && A_Z == 0)
	  Error_Handler();

  OLED_SendInitializeMessage(" IMU Calibration  ");

  uint32_t last_tick = HAL_GetTick();
  uint8_t Cal = 0;
  while (Cal == 0)
  {
      uint32_t now = HAL_GetTick();
      if ((now - last_tick) >= 1)
      {
          last_tick += 1;
          Cal = Acc_Cal();
      }
  }

  // Initialize CAN
  CAN_Filter.IdType = FDCAN_STANDARD_ID;
  CAN_Filter.FilterIndex = 0;
  CAN_Filter.FilterType = FDCAN_FILTER_DISABLE;
  CAN_Filter.FilterConfig = FDCAN_FILTER_TO_RXFIFO0;
  CAN_Filter.FilterID1 = 0;
  CAN_Filter.FilterID2 = 0;

  CAN_TX_Header.Identifier = 0x0A;
  CAN_TX_Header.IdType = FDCAN_STANDARD_ID;
  CAN_TX_Header.TxFrameType = FDCAN_DATA_FRAME;
  CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_8;
  CAN_TX_Header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  CAN_TX_Header.BitRateSwitch = FDCAN_BRS_ON;
  CAN_TX_Header.FDFormat = FDCAN_FD_CAN;
  CAN_TX_Header.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
  CAN_TX_Header.MessageMarker = 0;

  HAL_FDCAN_Start(&hfdcan1);
  HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);

  // Communicate with motor driver:

  OLED_SendInitializeMessage("  Motors Init    ");
  HAL_TIM_Base_Start_IT(&htim16);

  // Set current limits depending on selected robot and mode;

  while (MOTOR_DRIVER_INIT_FLAG == INIT)
  {
	  if(CAN_RX[0] == 0x01)
		  MOTOR_DRIVER_INIT_FLAG = SYNCED;
  }
  HAL_TIM_Base_Stop_IT(&htim16);
  // set motor temperature limits
  CAN_TX[0] = 0x12;
  CAN_TX[1] = MOTOR_MAX_TEMP;
  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
  HAL_Delay(100);
  if (CAN_RX[0] != 0x12 && CAN_RX[1] != CAN_TX[1])
	  MOTOR_DRIVER_INIT_FLAG = ERROR;

  // set motor Current limits
  CAN_TX[0] = 0x13;
  CAN_TX[1] = SUMO_MOTOR_MAX_CURRENT;
  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
  HAL_Delay(100);
  if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
	  MOTOR_DRIVER_INIT_FLAG = ERROR;

  //set motor current limits according to robot mode and selected robot
  Module_Switch[1] = HAL_GPIO_ReadPin(SW2_GPIO_Port, SW2_Pin);
  Module_Switch[0] = HAL_GPIO_ReadPin(SW1_GPIO_Port, SW1_Pin);
  if (Module_Switch[1] == SUMO || ROBOT != HIROSHIMA)
  {
	  // set motor Current limits
	  CAN_TX[0] = 0x13;
	  CAN_TX[1] = SUMO_MOTOR_MAX_CURRENT;
	  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
	  HAL_Delay(100);
	  if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
		  MOTOR_DRIVER_INIT_FLAG = ERROR;

	  // set motor constant current limits
	  CAN_TX[0] = 0x14;
	  CAN_TX[1] = SUMO_MOTOR_MAX_CONSTANT_CURRENT;
	  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
	  HAL_Delay(100);
	  if (CAN_RX[0] != 0x14 && CAN_RX[5] != CAN_TX[1])
		  MOTOR_DRIVER_INIT_FLAG = ERROR;

  }
  else if (Module_Switch[1] == MEGA_SUMO && Module_Switch[0] == 0 && ROBOT == HIROSHIMA) // mega sumo, not LF
  {
	  // set motor Current limits
	  CAN_TX[0] = 0x13;
	  CAN_TX[1] = MEGA_MOTOR_MAX_CURRENT;
	  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
	  HAL_Delay(100);
	  if (CAN_RX[0] != 0x13 && CAN_RX[3] != CAN_TX[1])
		  MOTOR_DRIVER_INIT_FLAG = ERROR;

	  // set motor constant current limits
	  CAN_TX[0] = 0x14;
	  CAN_TX[1] = MEGA_MOTOR_MAX_CONSTANT_CURRENT;
	  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
	  HAL_Delay(100);
	  if (CAN_RX[0] != 0x14 && CAN_RX[5] != CAN_TX[1])
		  MOTOR_DRIVER_INIT_FLAG = ERROR;

  }

  // Reverse motors depending on selected robot
  // reverse left motor
  CAN_TX[0] = 0x16;
  CAN_TX[LEFT_MOTOR]  = MOTOR_REVERSED_LEFT;
  CAN_TX[RIGHT_MOTOR] = MOTOR_REVERSED_RIGHT;
//  CAN_TX[1] = MOTOR_REVERSED_LEFT;
//  CAN_TX[2] = MOTOR_REVERSED_RIGHT;
  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
  HAL_Delay(100);
  if (CAN_RX[0] != 0x16)
	  MOTOR_DRIVER_INIT_FLAG = ERROR;

  if (MOTOR_DRIVER_INIT_FLAG == ERROR)
  {
	  OLED_SendInitializeMessage(" Motors FAILED   ");
	  HAL_Delay(100);
	  Error_Handler();
  }
  if (MOTOR_DRIVER_INIT_FLAG == SYNCED)
	  OLED_SendInitializeMessage(" Motors SUCCES   ");

  HAL_GPIO_WritePin(Motor_KILL_GPIO_Port, Motor_KILL_Pin, GPIO_PIN_SET);


  //Write Parameters, Make initial calculations etc.
  Line_Color_Threshold = LINE_LOW;

  OLED_SendInitializeMessage(" Watchdog Start   ");
  HAL_Delay(25);
  if (HAL_TIM_Base_Start_IT(&htim6) != HAL_OK)
	  Error_Handler();
  if (HAL_TIM_Base_Start_IT(&htim17) != HAL_OK)
	  Error_Handler();

  OLED_SendInitializeMessage("   COMPLETE    ");


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

