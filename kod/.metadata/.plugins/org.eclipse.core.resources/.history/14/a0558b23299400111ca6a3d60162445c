					ssd1306_SetCursor(10, 30);
					ssd1306_WriteString("COMM LOST", Font_11x18);
					ssd1306_UpdateScreen();
				}
			}
		}

	}
	else if (Timer % 2 == 0 && HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY)
	{
		ssd1306_Clear();
		ssd1306_SetCursor(40, 8);
		ssd1306_WriteString("MODE", Font_11x18);
