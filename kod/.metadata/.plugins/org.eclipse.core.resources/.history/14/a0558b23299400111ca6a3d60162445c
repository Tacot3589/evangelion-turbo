void MOTOR_DRIVER_SetDuty(uint8_t Motor, int8_t Duty)
{
	CAN_TX[0] = 0x51;
	Duty = MOTOR_Acceleration_Compensation(Duty);
	if	(Motor == RIGHT_MOTOR)
		CAN_TX[RIGHT_MOTOR] = Duty;

	else if (Motor == LEFT_MOTOR)
		CAN_TX[LEFT_MOTOR] = Duty;

	if (Motor == BOTH_MOTORS)
	{
		CAN_TX[LEFT_MOTOR] = Duty;
		CAN_TX[RIGHT_MOTOR] = Duty;
	}
	CAN_TX[3] = 0x01;
}
void MOTOR_DRIVER_TransmitData(void)
{
	HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
}
int8_t MOTOR_Acceleration_Compensation(int8_t Duty)
{
	static int8_t Last_Duty;
	static int16_t Timer;

	if (Duty > SUMO_VELOCITY_SEARCH && Duty > Last_Duty)
		Duty = Last_Duty + RAMP_STEP;

	Last_Duty = Duty;
	return Duty;
}

void TF_MINI_Init(uint8_t Sensor)
{
	// Select proper UART Interface
	UART_HandleTypeDef*UART = &TF_FRONT_LEFT;
	DMA_HandleTypeDef*DMA = &DMA_FRONT_LEFT;
	if (Sensor == TF_FL)
	{
		UART = &TF_FRONT_LEFT;
		DMA = &DMA_FRONT_LEFT;
	}
	else if (Sensor == TF_FR)
	{
		UART = &TF_FRONT_RIGHT;
		DMA = &DMA_FRONT_RIGHT;
	}
	else if (Sensor == TF_AL)
	{
		UART = &TF_ANGLE_LEFT;
		DMA = &DMA_ANGLE_LEFT;
	}
	else if (Sensor == TF_AR)
	{
		UART = &TF_ANGLE_RIGHT;
		DMA = &DMA_ANGLE_RIGHT;
	}

	//Send initialization instructions

	// Disable output
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x00;
	UART_TX[4] = 0x66;
	HAL_UART_Transmit_IT(UART, UART_TX, 5);
	HAL_UART_Receive(UART, LPUART1_RX, 5, 10);

//	HAL_Delay(100);
	// Enable output
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x01;
	UART_TX[4] = 0x67;
	HAL_UART_Transmit_IT(UART, UART_TX, 5);
	HAL_UART_Receive(UART, LPUART1_RX, 5, 10);

	// Set UART Interrupt frame in line with TFmini Initialization
	if (Sensor == TF_FL)
		HAL_UARTEx_ReceiveToIdle_DMA(UART, UART3_RX, 9);
	else if (Sensor == TF_FR)
		HAL_UARTEx_ReceiveToIdle_DMA(UART, LPUART1_RX, 9);
	else if (Sensor == TF_AL)
		HAL_UARTEx_ReceiveToIdle_DMA(UART, UART2_RX, 9);
	else if (Sensor == TF_AR)
		HAL_UARTEx_ReceiveToIdle_DMA(UART, UART1_RX, 9);

	__HAL_DMA_DISABLE_IT(DMA, DMA_IT_HT);
}
uint8_t TF_MINI_Config(uint8_t Sensor)
{
	uint8_t SUCCESS;
	// Select proper UART Interface
	UART_HandleTypeDef*UART = &TF_FRONT_LEFT;
	if (Sensor == TF_FL)
		UART = &TF_FRONT_LEFT;

	else if (Sensor == TF_FR)
		UART = &TF_FRONT_RIGHT;

	else if (Sensor == TF_AL)
		UART = &TF_ANGLE_LEFT;

	else if (Sensor == TF_AR)
		UART = &TF_ANGLE_RIGHT;

	// Disable output
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x00;
	UART_TX[4] = 0x66;

	HAL_UART_Transmit_IT(UART, UART_TX, 5);
	HAL_UART_Receive(UART, UART3_RX, 5, 1000);
	HAL_Delay(1000);

	// Set Frequency to 1000hz
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x06;
	UART_TX[2] = 0x03;
	UART_TX[3] = 0xE8; 	// LOW BYTE
	UART_TX[4] = 0x03;	// HIGH BYTE
	UART_TX[5] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3] + UART_TX[4]) % 0x100;

	HAL_UART_Transmit_IT(UART, UART_TX, 6);
	HAL_UART_Receive(UART, UART3_RX, 6, 1000);
	HAL_Delay(1000);


	// Set Baudrate to 921600
/*	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x08;
	UART_TX[2] = 0x06;
	UART_TX[3] = 0x00; 	// LOW BYTE
	UART_TX[4] = 0x10;	// MID LOW BYTE
	UART_TX[5] = 0x0E; 	// MID HIGH BYTE
	UART_TX[6] = 0x00;	// HIGH BYTE
	UART_TX[7] = 0xC0;
*/
	// Set Baudrate to 256000
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x08;
	UART_TX[2] = 0x06;
	UART_TX[3] = 0x00; 	// LOW BYTE
	UART_TX[4] = 0xE8;	// MID LOW BYTE
	UART_TX[5] = 0x03; 	// MID HIGH BYTE
	UART_TX[6] = 0x00;	// HIGH BYTE
	UART_TX[7] = 0x53;

	HAL_UART_Transmit_IT(UART, UART_TX, 8);
	HAL_UART_Receive(UART, UART3_RX, 8, 1000);
	HAL_Delay(1000);


	// Save Settings
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x04;
	UART_TX[2] = 0x11;
	UART_TX[3] = 0x6F;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;

//	HAL_UART_Transmit_IT(&huart2, UART_TX, 5);
	HAL_UART_Transmit(UART, UART_TX, 5, 1);
	HAL_UART_Receive(UART, UART3_RX, 6, 1000);

	if (UART3_RX[0] == 0x5A && UART3_RX[1] == 0x05 && UART3_RX[2] == 0x11 && UART3_RX[3] == 0x00 && UART3_RX[4] == 0x70)
		SUCCESS = 1;
	else
		SUCCESS = 0;

	return SUCCESS;
}

