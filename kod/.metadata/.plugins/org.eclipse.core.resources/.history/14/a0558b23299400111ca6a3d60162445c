/* USER CODE BEGIN 4 */
void HAL_FDCAN_RxFifo0Callback(FDCAN_HandleTypeDef *hfdcan, uint32_t RxFifo0ITs)
{
	uint16_t Buffer;
	static uint8_t 	CNT;

	HAL_FDCAN_GetRxMessage(hfdcan, FDCAN_RX_FIFO0, &CAN_RX_Header, CAN_RX);
	HAL_FDCAN_ActivateNotification(hfdcan, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);

	if (MOTOR_DRIVER_INIT_FLAG == DESYNCED)
	{
		if (CAN_RX[0] != 0x00 && CAN_RX[0] != 0xFF)
			MOTOR_DRIVER_INIT_FLAG = SYNCED;
	}

	else if(MOTOR_DRIVER_INIT_FLAG == SYNCED || MOTOR_DRIVER_INIT_FLAG == INIT)
	{
		if (CAN_RX[0] == 0x51)	// FRAME IS VALID first frame
		{
			// Send Battery Voltages
			Buffer = Supply_Voltage * 100;
			OLED_MotorDataBuffer(Buffer, 1, 1);
			Buffer = CAN_RX[1] << 8;
			Buffer = Buffer + CAN_RX[2];
			OLED_MotorDataBuffer(Buffer, 1, 3);
			Motor_Driver_Voltage = Buffer / 10;

			// Send Motor Duties
			OLED_MotorDataBuffer(CAN_RX[3], 2, 2);
			OLED_MotorDataBuffer(CAN_RX[5], 2, 1);
			OLED_MotorDataBuffer(CAN_RX[4], 2, 4);
			OLED_MotorDataBuffer(CAN_RX[6], 2, 3);
		}
		else if (CAN_RX[0] == 0x52)
		{// Send Motor Current
			Buffer = CAN_RX[1] << 8;
			Buffer = Buffer + CAN_RX[2];
			OLED_MotorDataBuffer(Buffer, 3, 1);
			Buffer = CAN_RX[3] << 8;
			Buffer = Buffer + CAN_RX[4];
			OLED_MotorDataBuffer(Buffer, 3, 3);

			// Send Temperatures
			OLED_MotorDataBuffer(CAN_RX[5], 4, 1);
			OLED_MotorDataBuffer(CAN_RX[6], 4, 3);
		}
		else if (CAN_RX[0] == 0x53)
		{
			// Temperatures CD
			OLED_MotorDataBuffer(CAN_RX[3], 4, 2);
			OLED_MotorDataBuffer(CAN_RX[4], 4, 4);
		}


		if (MOTOR_DRIVER_INIT_FLAG == INIT && CNT < 6)
			CNT++;
		if (CNT == 6)
		{
			MOTOR_DRIVER_INIT_FLAG = SYNCED;
			CNT = 10;
		}
		MOTOR_DRIVER_TIMEOUT = 0;
//		DUPA++;
	}

}

void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{

	uint8_t j, k;
	uint16_t Distance, Strength, Temperature;
	uint8_t Interface;
	if(huart->Instance == LPUART1)
	{
		// Select which uart received message
		Interface = 0;

		// Parse message to common buffer
		for (int i = 1; i < 9; i++)
		{
			if (LPUART1_RX[i-1] == 0x59 && LPUART1_RX[i] == 0x59)
			{
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Distance = LPUART1_RX[j] + (LPUART1_RX[k] << 8);
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Strength = LPUART1_RX[j] + (LPUART1_RX[k] << 8);
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temperature = LPUART1_RX[j] + (LPUART1_RX[k] << 8);
				break;
			}
			else if (LPUART1_RX[0] == 0x59 && LPUART1_RX[8] == 0x59)
			{
				Distance = LPUART1_RX[1] + (LPUART1_RX[2] << 8);
				Strength = LPUART1_RX[3] + (LPUART1_RX[4] << 8);
				Temperature = LPUART1_RX[5] + (LPUART1_RX[6] << 8);
			}
		}
		HAL_UARTEx_ReceiveToIdle_DMA(&hlpuart1, LPUART1_RX, 9);
		__HAL_DMA_DISABLE_IT(&hdma_lpuart1_rx, DMA_IT_HT);
	}
	if(huart->Instance == USART3)
	{
		// Select which uart received message
		Interface = 3;

		// Parse message to common buffer
		for (int i = 1; i < 9; i++)
		{
			if (UART3_RX[i-1] == 0x59 && UART3_RX[i] == 0x59)
			{
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Distance = UART3_RX[j] + (UART3_RX[k] << 8);
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Strength = UART3_RX[j] + (UART3_RX[k] << 8);
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temperature = UART3_RX[j] + (UART3_RX[k] << 8);
				break;
			}
			else if (UART3_RX[0] == 0x59 && UART3_RX[8] == 0x59)
			{
				Distance = UART3_RX[1] + (UART3_RX[2] << 8);
				Strength = UART3_RX[3] + (UART3_RX[4] << 8);
				Temperature = UART3_RX[5] + (UART3_RX[6] << 8);
			}
		}
		HAL_UARTEx_ReceiveToIdle_DMA(&huart3, UART3_RX, 9);
		__HAL_DMA_DISABLE_IT(&hdma_usart3_rx, DMA_IT_HT);
	}
	if(huart->Instance == USART2)
	{
		// Select which uart received message
		Interface = 2;

		// Parse message to common buffer
		for (int i = 1; i < 9; i++)
		{
			if (UART2_RX[i-1] == 0x59 && UART2_RX[i] == 0x59)
			{
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Distance = UART2_RX[j] + (UART2_RX[k] << 8);
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Strength = UART2_RX[j] + (UART2_RX[k] << 8);
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temperature = UART2_RX[j] + (UART2_RX[k] << 8);
				break;
			}
			else if (UART2_RX[0] == 0x59 && UART2_RX[8] == 0x59)
			{
				Distance = UART2_RX[1] + (UART2_RX[2] << 8);
				Strength = UART2_RX[3] + (UART2_RX[4] << 8);
				Temperature = UART2_RX[5] + (UART2_RX[6] << 8);
			}
		}
		HAL_UARTEx_ReceiveToIdle_DMA(&huart2, UART2_RX, 9);
		__HAL_DMA_DISABLE_IT(&hdma_usart2_rx, DMA_IT_HT);
	}
	if(huart->Instance == USART1)
	{
		// Select which uart received message
		Interface = 1;

		// Parse message to common buffer
		for (int i = 1; i < 9; i++)
		{
			if (UART1_RX[i-1] == 0x59 && UART1_RX[i] == 0x59)
			{
				j = (i + 1) % 9;
				k = (i + 2) % 9;
				Distance = UART1_RX[j] + (UART1_RX[k] << 8);
				j = (i + 3) % 9;
				k = (i + 4) % 9;
				Strength = UART1_RX[j] + (UART1_RX[k] << 8);
				j = (i + 5) % 9;
				k = (i + 6) % 9;
				Temperature = UART1_RX[j] + (UART1_RX[k] << 8);
				break;
			}
			else if (UART1_RX[0] == 0x59 && UART1_RX[8] == 0x59)
			{
				Distance = UART1_RX[1] + (UART1_RX[2] << 8);
				Strength = UART1_RX[3] + (UART1_RX[4] << 8);
				Temperature = UART1_RX[5] + (UART1_RX[6] << 8);
			}
		}
		HAL_UARTEx_ReceiveToIdle_DMA(&huart1, UART1_RX, 9);
		__HAL_DMA_DISABLE_IT(&hdma_usart1_rx, DMA_IT_HT);
	}

	// Assign received data to corresponding sensor
	if (Interface == TF_FL)
	{
		FRONT_LEFT_Distance = Distance;
		FRONT_LEFT_Return = Strength;
		FRONT_LEFT_Temperature = Temperature;
	}
	if (Interface == TF_FR)
	{
		FRONT_RIGHT_Distance = Distance;
		FRONT_RIGHT_Return = Strength;
		FRONT_RIGHT_Temperature = Temperature;
	}
	if (Interface == TF_AL)
	{
		ANGLE_LEFT_Distance = Distance;
		ANGLE_LEFT_Return = Strength;
		ANGLE_LEFT_Temperature = Temperature;
	}
	if (Interface == TF_AR)
	{
		ANGLE_RIGHT_Distance = Distance;
		ANGLE_RIGHT_Return = Strength;
		ANGLE_RIGHT_Temperature = Temperature;
	}
}

