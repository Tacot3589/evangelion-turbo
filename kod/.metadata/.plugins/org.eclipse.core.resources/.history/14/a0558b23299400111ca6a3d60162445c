void OLED_Interrupt_25Hz(void)
{
	static 	uint16_t 	Timer;
	static 	uint8_t		OLED_Mode;

	static uint8_t		Exception;
	static uint8_t 		Combat_Interrupt;

//	extern float 		Angle;

	// Select message based on timeframe
	if (Timer % 200 == 25)
		OLED_Mode = 0;
	if (Timer % 200 == 110)
		OLED_Mode = 2;
	if (Timer % 200 == 125)
		OLED_Mode = 1;
	if (Timer % 200 == 10)
		OLED_Mode = 3;

	// Overwrite message with exception

	// Activate SUMO / MEGA SUMO / MICROMAUSE switch communicate
	if (Combat_mode != Combat_Interrupt)
	{
		Exception = 1;
		Timer = 0;
		Combat_Interrupt = Combat_mode;
	}
	// Deactivate communicate after selected time
	else if (Exception == 1 && Timer > 100)
		Exception = 0;

	Timer++;
	Timer 	= Timer % 1000;

	if (Timer % 2 == 0 && HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY && Exception == 0)
	{
/*		// temp angle data
		char str[5];
		sprintf( str, "%.2f", Angle);
		ssd1306_Clear();
		ssd1306_SetCursor(25, 10);
		ssd1306_WriteString(str, Font_11x18);
		ssd1306_SetCursor(10, 30);
//			ssd1306_WriteString("COMM LOST", Font_11x18);
		ssd1306_UpdateScreen();
		// Tmep Angle data
*/

		// Display current sumo mode when switched
		if (OLED_Mode == 0)
			OLED_DisplayData();
		else if (OLED_Mode == 2)
		{
			if (BATTERY_UndervoltageProtection(Battery_Type) == 0)
				OLED_DisplayData();
			else
				OLED_DisplayLOW_BATTERY();
		}
		else if (OLED_Mode == 1)
		{
		if (MOTOR_DRIVER_INIT_FLAG == SYNCED)
				OLED_MotorDataBuffer(0, 0, 5);
			else
			{
				ssd1306_Clear();
				ssd1306_SetCursor(25, 10);
				ssd1306_WriteString("MOTORS", Font_11x18);
				ssd1306_SetCursor(10, 30);
				ssd1306_WriteString("COMM LOST", Font_11x18);
				ssd1306_UpdateScreen();
			}
		}
		else if (OLED_Mode == 3)
		{
			if (Motor_Driver_Voltage < LI_PO_11V1_LOW)
				OLED_DisplayLOW_BATTERY_Motor();
			else
			{
				if (MOTOR_DRIVER_INIT_FLAG == SYNCED)
					OLED_MotorDataBuffer(0, 0, 5);
				else
				{
					ssd1306_Clear();
					ssd1306_SetCursor(25, 10);
