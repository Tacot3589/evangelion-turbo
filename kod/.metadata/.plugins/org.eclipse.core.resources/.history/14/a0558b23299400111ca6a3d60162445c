			ssd1306_WriteString("MEGA SUMO", Font_11x18);
		}
		else if (Combat_mode == MICROMAUSE)
		{
			ssd1306_SetCursor(12, 32);
			ssd1306_WriteString("MICROMAUSE", Font_11x18);
		}
