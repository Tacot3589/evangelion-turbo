static inline uint8_t Sensor_Out(uint8_t channel)
{
	uint8_t status;

	if (ADC_readout[channel] < ADC_threshold_LO || ADC_readout[channel] >= ADC_threshold_HI)
		status = 1;
	else
		status = 0;

    return status;
}

uint8_t RingStatus(uint8_t Sensors)
{
	uint8_t Status = ON_RING;

	Status = ON_RING;

	if (Sensors == 4)
	{
		// Both Rear Left sensors out
		if (Sensor_Out(ADC_CHANNEL_REAR_LEFT_LINE_A) && Sensor_Out(ADC_CHANNEL_REAR_LEFT_LINE_B))
			Status = REAR_LEFT_OUT;

		// Both Rear Right sensors out
		else if (Sensor_Out(ADC_CHANNEL_REAR_RIGHT_LINE_A) && Sensor_Out(ADC_CHANNEL_REAR_RIGHT_LINE_B))
			Status = REAR_RIGHT_OUT;
	}
	// Both Front Left sensors out
	if (Sensor_Out(ADC_CHANNEL_LEFT_LINE_A) && Sensor_Out(ADC_CHANNEL_LEFT_LINE_B))
		Status = FRONT_LEFT_OUT;

	// Both Front Right sensors out
	else if (Sensor_Out(ADC_CHANNEL_RIGHT_LINE_A) && Sensor_Out(ADC_CHANNEL_RIGHT_LINE_B))
		Status = FRONT_RIGHT_OUT;

	if (Sensors == 0)
		Status = ON_RING;

	return Status;
}

uint8_t EnemyLocation(uint8_t Nbr_of_Sensors)
{
	uint8_t feedback;
	feedback = ENEMY_LOST;

	// Front sensors
	if 		(FRONT_LEFT_Distance > 1 && FRONT_LEFT_Distance <= TFMINI_MAX_RANGE &&
			 FRONT_RIGHT_Distance > 1 && FRONT_RIGHT_Distance <= TFMINI_MAX_RANGE)
		feedback = ENEMY_FRONT;

	else if (FRONT_LEFT_Distance <= TFMINI_MAX_RANGE && FRONT_LEFT_Distance > 1)
		feedback = ENEMY_FRONT_LEFT;

	else if (FRONT_RIGHT_Distance <= TFMINI_MAX_RANGE && FRONT_RIGHT_Distance > 1)
		feedback = ENEMY_FRONT_RIGHT;

	// Optional angle sensors
	if (Nbr_of_Sensors > 2 && feedback == ENEMY_LOST)
	{
		if (ANGLE_LEFT_Distance <= TFMINI_MAX_RANGE && ANGLE_LEFT_Distance > 1)
			feedback = ENEMY_LEFT;

		else if (ANGLE_RIGHT_Distance <= TFMINI_MAX_RANGE && ANGLE_RIGHT_Distance > 1)
			feedback = ENEMY_RIGHT;
	}
	return feedback;
}

uint8_t BATTERY_SelectType(void)
{

	uint8_t BatteryTypeX;
	float Voltage;

	Voltage = ADC_readout[ADC_CHANNEL_BATTERY_VOLTAGE] * Voltage_Calculation_Constant;

	// Check witch type of battery match with measured voltage
	if (Voltage >= LI_PO_11V1_LOW && Voltage <= LI_PO_11V1_HI)
		BatteryTypeX = LI_PO_11V1;

	else if (Voltage >= LI_PO_7V4_LOW && Voltage <= LI_PO_7V4_HI)
		BatteryTypeX = LI_PO_7V4;

	else
		BatteryTypeX = UNKNOWN;

	return BatteryTypeX;
}

uint8_t BATTERY_UndervoltageProtection(uint8_t BatteryType)
{
	static uint8_t Battery_Increment;
	static float Battery_Voltage_Table[20];
	float Voltage;
	float Battery_Average_Voltage;
	uint8_t output;

	Voltage = ADC_readout[ADC_CHANNEL_BATTERY_VOLTAGE] * Voltage_Calculation_Constant;

	Battery_Voltage_Table[Battery_Increment] = Voltage;
	Battery_Increment++;
	output = 0;
	if (Battery_Increment == 20)
	{
		Battery_Increment = 0;
		Battery_Average_Voltage = 0;
		for (int i = 0; i<=19; i++)
		{
			Battery_Average_Voltage += Battery_Voltage_Table[i];
		}
		Battery_Average_Voltage = Battery_Average_Voltage / 20.0;

		if (BatteryType == LI_PO_7V4 && Battery_Average_Voltage <= LI_PO_7V4_LOW)
		{
			HAL_GPIO_WritePin(Power_EN_GPIO_Port, Power_EN_Pin, GPIO_PIN_SET);
			output = 1;
		}

		if (BatteryType == LI_PO_11V1 && Battery_Average_Voltage <= LI_PO_11V1_LOW)
		{
			HAL_GPIO_WritePin(Power_EN_GPIO_Port, Power_EN_Pin, GPIO_PIN_SET);
			output = 1;
		}
	}
	return output;
}

