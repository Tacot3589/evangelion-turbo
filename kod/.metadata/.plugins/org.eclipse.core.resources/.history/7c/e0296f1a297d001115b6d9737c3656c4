void Run(void)
{
	static int16_t Duty;
	uint8_t Error;

	// Measure motor current
	MovingAverage(ADC2_BUFFER[Current]);

	// Check For Over-current Errors
	Error = Motor_Error & SDOC;

	// Increase Duty cycle only if there is no Error
	// Motor A
	if	(CAN_Duty == 0 )							// Forward Movement, Decelerating
		Duty = CAN_Duty;
	else if	(CAN_Duty > 0 	&& 	CAN_Duty <=  1000 		&& 	Duty >= CAN_Duty)							// Forward Movement, Decelerating
		Duty = CAN_Duty;
	else if (CAN_Duty < 0 	&& 	CAN_Duty >= -1000		&& 	Duty <= CAN_Duty)							// Reverse Movement, Decelerating
		Duty = CAN_Duty;
	else if (CAN_Duty > 0 	&& 	CAN_Duty <=  1000		&& 	Duty <= CAN_Duty 	&& 	Error == OK)		// Forward Movement, Accelerating
		Duty = CAN_Duty;
	else if (CAN_Duty < 0 	&& 	CAN_Duty >= -1000		&& 	Duty >= CAN_Duty	&& 	Error == OK)		// Reverse Movement, Accelerating
		Duty = CAN_Duty;

	// Call Motor Control
	Duty = Motor_Control(Duty, MOTOR_A);

	// Send Duty Data to Buffers
	Actual_Duty = Duty;
}

