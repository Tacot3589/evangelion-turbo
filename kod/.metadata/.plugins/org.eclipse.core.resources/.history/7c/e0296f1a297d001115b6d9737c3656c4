// Filters and data
void MovingAverage(uint16_t Measured_Current)
{
    static uint32_t Data_tableCA[16];
    static uint8_t Index;
    static uint16_t SumCA;

    SumCA = SumCA - Data_tableCA[Index];
    Data_tableCA[Index] = Measured_Current;
    SumCA = SumCA + Data_tableCA[Index];

    Index = (Index + 1) % 16;
    CurrentA_Average	= SumCA >> 4;
    if (CurrentA_Average > C_OFFSET)
     	CurrentA_Average = CurrentA_Average - C_OFFSET;
     else
     	CurrentA_Average = 0;
    Motor_Current = (float)(CurrentA_Average) * Current_constant;
}


int16_t Motor_Control(int16_t Duty, uint8_t MOTOR)
{
	// Check all errors
	LDOC_check(MOTOR);
	Duty = OverCurrent_Compensation(Duty, MOTOR);
	Duty = OverTemp_Compensation(Duty, MOTOR);

	// Execute Ramp

	// Apply new Duty to motor
	Set_Motor(MOTOR, Duty);

	return Duty; // return applied duty to motor
}


int16_t OverCurrent_Compensation(int16_t Duty, uint8_t Motor)
{
	static uint8_t Error;

	if (Duty > 0) 									// Forward
	{
		if 	(Motor_Current > Max_Current_Peak)
		{
			Duty--;
			Error = SDOC;
		}
		else if (Duty < CAN_Duty)
			Duty++;
		else
			Error = OK;
	}


	else if (Duty < 0) 								// reverse
	{
		if 	(Motor_Current > Max_Current_Peak)
		{
			Duty++;
			Error = SDOC;
		}
		else if (Duty > CAN_Duty)
			Duty--;
		else
			Error = OK;
	}
	else
		if 	(Motor_Current > Max_Current_Peak)
			Error = SDOC;

		else
			Error = OK;


	// Set Motor Error Global Flag
	if (Error == SDOC)
		Motor_Error = Motor_Error | SDOC;
	else
		Motor_Error = Motor_Error & 0xFB;

	return Duty;
}


int16_t OverTemp_Compensation(int16_t Duty, uint8_t Motor)
{
	uint8_t Error = OK;

	if (FET_Temperature > (FET_Temp_Limit - 20) && Duty > 0 && Duty > OVERTEMP_DUTY)
	{
		Duty = OVERTEMP_DUTY;
		// Reduce VREF
		Error = OVERTEMP_FET;
		Motor_Error = Motor_Error | Error;
	}

	if (Motor_Temperature > (Motor_Temp_Limit - 20) && Duty > 0 && Duty > OVERTEMP_DUTY)
	{
		Duty = OVERTEMP_DUTY;
		// Reduce VREF
		Error = OVERTEMP_MOTOR;
		Motor_Error = Motor_Error | Error;
	}

	if (FET_Temperature > FET_Temp_Limit || Motor_Temperature > Motor_Temp_Limit)
	{
		Motor_Error = Motor_Error | CRITICAL_ERROR;
		EmergencyShutdown();
	}

	// Clear errors
	if (Error == OK)
		Motor_Error = Motor_Error & 0xE7;

	return Duty;
}


void EmergencyShutdown(void)
{
	MACHINE_STATE = ERROR;
	HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, 0);
	TIM2->CCR1 = 0;
}


uint8_t LDOC_check(uint8_t Motor)
{
	// execution of this function should be 10kHz
	// Cutoff time should be around 2s
	static uint32_t timer;
	uint8_t Status = OK;

	if (Motor_Current > Max_Current_Continous && timer < (LONG_DURATION_THRESHOLD * 10 ))			// if current higher than LDCL - set flag high
		timer++;
	else
		timer = 0;

	if (timer >= (LONG_DURATION_THRESHOLD * 10 ))
	{
		Motor_Error = Motor_Error | LDOC;
		EmergencyShutdown();
	}
	return Status;
}


void Set_Motor (uint8_t motor, int16_t velocity)
{
//	uint16_t CCR_Value;
	if (velocity >= -1000 && velocity <=1000)
	{
		if(velocity >= 0 )			//	Forward
		{
//			CCR_Value = (velocity * TIM3->ARR) / 1000;
			TIM2->CCR1 = velocity;
			HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, GPIO_PIN_SET);
		}
		else if (velocity < 0)		// Reverse
		{
//			CCR_Value = (-velocity * TIM3->ARR) / 1000;
			TIM2->CCR1 = -velocity;
			HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, GPIO_PIN_RESET);
		}
	}

	else if (velocity > 1000)
	{
//		CCR_Value = (velocity * TIM3->ARR) / 1000;
		TIM2->CCR1 = 1000;
		HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, GPIO_PIN_SET);
	}
	else if (velocity < -1000)		// Reverse
	{
//			CCR_Value = (-velocity * TIM3->ARR) / 1000;
		TIM2->CCR1 = 1000;
		HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, GPIO_PIN_RESET);
	}
}


void Calculate_Temp (void)
{
	float temp;
	float rntc;

	if (ADC1_BUFFER[FET_Temp] < 4000)
	{
		rntc = (float)NTC_Series_Resistor / (((float)ADC_MAX_VALUE / (float)ADC1_BUFFER[FET_Temp]) - 1.0f);
		temp = rntc / (float)NTC_Nominal_Resistance;
		temp = logf(temp);
		temp /= (float)NTC_Beta;
		temp += 1.0f / ((float)NTC_Nominal_Temperature + 273.15f);
		temp = 1.0f / temp;
		temp -= 273.15f;
		FET_Temperature = temp;
	}
	else
		FET_Temperature = 0;
}
