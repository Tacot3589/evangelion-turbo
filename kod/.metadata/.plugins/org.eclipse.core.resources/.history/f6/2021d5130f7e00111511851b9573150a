void HAL_FDCAN_RxFifo0Callback(FDCAN_HandleTypeDef *hfdcan, uint32_t RxFifo0ITs)
{
	static uint8_t Can_Phase;
	uint16_t Battery_Voltage_Buffer;
	uint16_t Motor_Current_Buffer	[2];
	int8_t	Duty_Buff				[2];

	HAL_FDCAN_GetRxMessage(hfdcan, FDCAN_RX_FIFO0, &CAN_RX_Header, CAN_RX);
	HAL_FDCAN_ActivateNotification(hfdcan, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);
	CAN_STATUS_FLAG = 1;

	// Write data to Buffers
	switch (CAN_RX[0])
	{
		case 0x01:	// STATUS FRAME
			//	Do nothing

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_8;
			//	Send Response
			CAN_TX[0] = 0x01;
			CAN_TX[1] = Battery_Voltage * 10;
			CAN_TX[2] = Actual_Duty[0];
			CAN_TX[3] = Actual_Duty[1];
			if(FET_Temperature[0] > FET_Temperature[1])
				CAN_TX[4] = FET_Temperature[0];
			else
				CAN_TX[4] = FET_Temperature[1];
			CAN_TX[5] = Motor_Current[0] * 10;
			CAN_TX[6] = Motor_Current[1] * 10;
			CAN_TX[7] = MACHINE_STATE;
		break;
		case 0x10:	// SET CAN STANDARD
			// Write CAN Format to registers
			CAN_Format = CAN_RX[1];

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_5;
			//	Send Response
			CAN_TX[0] = 0x10;
			CAN_TX[1] = CAN_Format;
			CAN_TX[2] = CAN_Addres_Mask;
			CAN_TX[3] = CAN_ADDR[0];
			CAN_TX[4] = CAN_ADDR[1];
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
		break;
		case 0x11:	// SET CAN ADDRES
			// Write CAN Address to registers
			CAN_Addres_Mask = CAN_RX[1];
			CAN_ADDR[0] = CAN_RX[2];
			CAN_ADDR[1] = CAN_RX[3];

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_5;
			//	Send Response
			CAN_TX[0] = 0x11;
			CAN_TX[1] = CAN_Format;
			CAN_TX[2] = CAN_Addres_Mask;
			CAN_TX[3] = CAN_ADDR[0];
			CAN_TX[4] = CAN_ADDR[1];
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
		break;
		case 0x12:	// SET MOTOR TEMPERATURE LIMIT
			// Write Temperatures to registers
			if (CAN_RX[1] != 0xFF)		Motor_Temp_Limit = CAN_RX[1];


			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_7;
			//	Send Response
			CAN_TX[0] = 0x12;
			CAN_TX[1] = Motor_Temp_Limit;
			CAN_TX[2] = 0x00;
			CAN_TX[3] = Max_Current_Peak;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = Max_Current_Continous;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
		break;
		case 0x13:	// SET MOTOR PEAK CURRENT LIMIT
			// Write Current Limits to registers
			if (CAN_RX[1] != 0xFF)		Max_Current_Peak = CAN_RX[1];


			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_7;
			//	Send Response
			CAN_TX[0] = 0x13;
			CAN_TX[1] = Motor_Temp_Limit;
			CAN_TX[2] = 0x00;
			CAN_TX[3] = Max_Current_Peak;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = Max_Current_Continous;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x14:	// SET MOTOR CONSTANT CURRENT LIMIT
			// Write Current Limits to registers
			if (CAN_RX[1] != 0xFF)		Max_Current_Continous = CAN_RX[1];


			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_7;
			//	Send Response
			CAN_TX[0] = 0x14;
			CAN_TX[1] = Motor_Temp_Limit;
			CAN_TX[2] = 0x00;
			CAN_TX[3] = Max_Current_Peak;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = Max_Current_Continous;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x15:	// SET MOTOR MAX ACCELERATION AND DECELERATION
			// Write Acceleration limits to registers
			if (CAN_RX[1] != 0xFF)		Max_Acceleration[0] = CAN_RX[1];
			if (CAN_RX[2] != 0xFF)		Max_Acceleration[1] = CAN_RX[2];
			if (CAN_RX[3] != 0xFF)		Max_Deceleration[0] = CAN_RX[3];
			if (CAN_RX[4] != 0xFF)		Max_Deceleration[1] = CAN_RX[4];

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_5;
			//	Send Response
			CAN_TX[0] = 0x15;
			CAN_TX[1] = Max_Acceleration[0];
			CAN_TX[2] = Max_Acceleration[1];
			CAN_TX[3] = Max_Deceleration[0];
			CAN_TX[4] = Max_Deceleration[1];
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x16:	// SET MOTOR MAX ACCELERATION AND DECELERATION
			// Write Acceleration limits to registers
			if 		(CAN_RX[1] == 0x01)		REVERSED[MOTOR_A] = TRUE;
			else if (CAN_RX[1] == 0x00)		REVERSED[MOTOR_A] = FALSE;
			if 		(CAN_RX[2] == 0x01)		REVERSED[MOTOR_B] = TRUE;
			else if (CAN_RX[2] == 0x00)		REVERSED[MOTOR_B] = FALSE;

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_5;
			//	Send Response
			CAN_TX[0] = 0x16;
			CAN_TX[1] = REVERSED[MOTOR_A];
			CAN_TX[2] = REVERSED[MOTOR_B];
			CAN_TX[3] = 0x00;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x1D:	// STORE SETTINGS IN FLASH
			//Save data in Flash

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_2;
			//	Send Response
			CAN_TX[0] = 0x1D;
			CAN_TX[1] = 0x1D;
			CAN_TX[2] = 0x00;
			CAN_TX[3] = 0x00;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x1C:	// RESET SETTINGS TO FACTORY DEFAULTS
			// Load Factory defaults data
			// Clear Flash memory

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_2;
			//	Send Response
			CAN_TX[0] = 0x1C;
			CAN_TX[1] = 0x1C;
			CAN_TX[2] = 0x00;
			CAN_TX[3] = 0x00;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x20:	// SET OPERATION MODE
			//Set Up Operation Mode

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_8;
			//	Send Response
			CAN_TX[0] = 0x20;
			CAN_TX[1] = 0xA1;	// For Now, run only in standard mode
			CAN_TX[2] = 0x00;
			CAN_TX[3] = 0x00;
			CAN_TX[4] = 0x00;
			CAN_TX[5] = 0x00;
			CAN_TX[6] = 0x00;
			CAN_TX[7] = 0x00;
	    break;
		case 0x50:	// MOTOR DUTY - STANDARD COMPACT FEEDBACK
			// Set Motor Duties
			if (CAN_RX[1] != 0xFF)				CAN_Duty[0] = CAN_RX[1] * 10;		// Id duty is set to 0xFF Do not update the register
			if (CAN_RX[2] != 0xFF)				CAN_Duty[1] = CAN_RX[2] * 10;
			if (MACHINE_STATE != ERROR) 		MACHINE_STATE = CAN_RX[3];

			//Update State Machine if allowed

			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_8;
			//	Send Response
			CAN_TX[0] = 0x50;
			CAN_TX[1] = Battery_Voltage * 10;
			CAN_TX[2] = Actual_Duty[0] / 10;
			CAN_TX[3] = Actual_Duty[1] / 10;
			if (FET_Temperature[0] > FET_Temperature[1])	CAN_TX[4] = FET_Temperature[0];
			else											CAN_TX[4] = FET_Temperature[1];
			CAN_TX[5] = Motor_Current[0] * 10;
			CAN_TX[6] = Motor_Current[1] * 10;
			if (Motor_Error[1] > Motor_Error[0])			CAN_TX[7] = Motor_Error [1];
			else											CAN_TX[7] = Motor_Error [0];
	    break;
		case 0x51: // MOTOR DUTY - 3 FRAME EXTENDED FEEDBACK
			// Set Motor Duties
			if (CAN_RX[1] != 0xFF)							Duty_Buff[0] = CAN_RX[1];		// Id duty is set to 0xFF Do not update the register
			if (CAN_RX[2] != 0xFF)							Duty_Buff[1] = CAN_RX[2];
			if (MACHINE_STATE != ERROR) 					MACHINE_STATE = CAN_RX[3]; 			// Set up Machine state into Run or Idle

			CAN_Duty[MOTOR_A] = Duty_Buff[0] * 10;
			CAN_Duty[MOTOR_B] = Duty_Buff[1] * 10;

			if(REVERSED[MOTOR_A] == TRUE)
				CAN_Duty[MOTOR_A] = -CAN_Duty[MOTOR_A];

			if(REVERSED[MOTOR_B] == TRUE)
				CAN_Duty[MOTOR_B] = -CAN_Duty[MOTOR_A];


			// Configure response length
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_7;
			//	Send Response
			if (Can_Phase == 0)
			{
				Battery_Voltage_Buffer = Battery_Voltage * 100;

				CAN_TX[0] = 0x51;
				CAN_TX[1] = Battery_Voltage_Buffer >> 8;
				CAN_TX[2] = Battery_Voltage_Buffer;

				if (REVERSED[MOTOR_A] == TRUE)		CAN_TX[3] = -Actual_Duty[0] / 10;
				else 								CAN_TX[3] = Actual_Duty[0] / 10;

				if (REVERSED[MOTOR_B] == TRUE)		CAN_TX[4] = -Actual_Duty[1] / 10;
				else 								CAN_TX[4] = Actual_Duty[1] / 10;

				CAN_TX[5] = CAN_RX[1];
				CAN_TX[6] = CAN_RX[2];
				CAN_TX[7] = 0x00;
			}
			if (Can_Phase == 1)
			{
				Motor_Current_Buffer[0] = Motor_Current[0] * 100;
				Motor_Current_Buffer[1] = Motor_Current[1] * 100;

				CAN_TX[0] = 0x52;
				CAN_TX[1] = Motor_Current_Buffer[0] >> 8;
				CAN_TX[2] = Motor_Current_Buffer[0];
				CAN_TX[3] = Motor_Current_Buffer[1] >> 8;
				CAN_TX[4] = Motor_Current_Buffer[1];
				CAN_TX[5] = Motor_Temperature[0];
				CAN_TX[6] = Motor_Temperature[1];
				CAN_TX[7] = 0x00;
			}

			if (Can_Phase == 2)
			{
				CAN_TX[0] = 0x53;
				CAN_TX[1] = Motor_Error[0];
				CAN_TX[2] = Motor_Error[1];
				CAN_TX[3] = FET_Temperature[0];
				CAN_TX[4] = FET_Temperature[1];
				CAN_TX[5] = 0x00;
				CAN_TX[6] = 0x00;
				CAN_TX[7] = 0x00;
			}

			Can_Phase++;
			Can_Phase = Can_Phase % 3;
	    break;
		case 0x54: // MOTOR DUTY AND ACCELERATION - STANDARD COMPACT FEEDBACK

	    break;
		case 0x55: // MOTOR DUTY AND ACCELERATION- 3 FRAME EXTENDED FEEDBACK

	    break;
		default:
			CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_2;
			CAN_TX[0] = 0xEE;
			CAN_TX[1] = 0xEE;
		break;

	}
	// Prepare response
	HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);
	DUPA++;

}

