  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK)
 	  Error_Handler();
  if (HAL_ADCEx_Calibration_Start(&hadc2, ADC_SINGLE_ENDED) != HAL_OK)
	  Error_Handler();

  if (HAL_ADC_Start_DMA(&hadc1, ADC_readout_A, 5) != HAL_OK)
	  Error_Handler();
  if (HAL_ADC_Start_DMA(&hadc2, ADC_readout_B, 2) != HAL_OK)
	  Error_Handler();

  DAC_Value = 2000;

  HAL_DAC_Start(&hdac1, DAC_CHANNEL_1);
  HAL_DAC_Start(&hdac1, DAC_CHANNEL_2);

  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, DAC_Value);
  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_2, DAC_ALIGN_12B_R, DAC_Value);

  MACHINE_STATE = IDLE;

  TIM2->CCR1 = 0;
  TIM2->CCR3 = 0;
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3);
  HAL_GPIO_WritePin(A_DIRECTION_GPIO_Port, A_DIRECTION_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(B_DIRECTION_GPIO_Port, B_DIRECTION_Pin, GPIO_PIN_RESET);

  HAL_Delay(100);
  HAL_GPIO_WritePin(Power_EN_GPIO_Port, Power_EN_Pin, GPIO_PIN_SET);
  HAL_Delay(100);
  HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_SET);

  Battery_constant =  ((Voltage_Resistor_Top + Voltage_Resistor_Bottom) / Voltage_Resistor_Bottom) * Reference_Voltage / 4096;
  Current_constant =  (Reference_Voltage / 4096.0 / Shunt_Resistor / 10.0) ;

  // Load Default parameters
  Motor_Temp_Limit = MAX_MOTOR_TEMPERATURE;
  FET_Temp_Limit = MAX_FET_TEMPERATURE;
  Max_Current_Continous = LONG_DURATION_CURRENT_LIMIT;
  Max_Current_Peak = SHORT_DURATION_CURRENT_LIMIT;
  REVERSED[MOTOR_A] = FALSE;
  REVERSED[MOTOR_B] = FALSE;

  // Initialize CAN
  CAN_Filter.IdType = FDCAN_STANDARD_ID;
  CAN_Filter.FilterIndex = 0;
  CAN_Filter.FilterType = FDCAN_FILTER_DISABLE;
  CAN_Filter.FilterConfig = FDCAN_FILTER_TO_RXFIFO0;
  CAN_Filter.FilterID1 = 0;
  CAN_Filter.FilterID2 = 0;

  CAN_TX_Header.Identifier = 0x0B;
  CAN_TX_Header.IdType = FDCAN_STANDARD_ID;
  CAN_TX_Header.TxFrameType = FDCAN_DATA_FRAME;
  CAN_TX_Header.DataLength = FDCAN_DLC_BYTES_8;
  CAN_TX_Header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  CAN_TX_Header.BitRateSwitch = FDCAN_BRS_ON;
  CAN_TX_Header.FDFormat = FDCAN_FD_CAN;
  CAN_TX_Header.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
  CAN_TX_Header.MessageMarker = 0;

  HAL_FDCAN_Start(&hfdcan1);
  HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);
  CAN_TX[3] = 5;
  HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &CAN_TX_Header, CAN_TX);

  HAL_TIM_Base_Start_IT(&htim6);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

