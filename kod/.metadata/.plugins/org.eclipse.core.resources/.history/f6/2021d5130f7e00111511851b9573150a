void Idle(void)
{
	// Disable Motor Drivers in IDLE
	HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_RESET);
	// Set PWM to 0
	TIM2->CCR1 = 0;
	TIM2->CCR3 = 0;
}
void Run(void)
{
	static int16_t Duty		[2];
	uint8_t Error			[2];

	if (Input_KILL == 1)
	{
		// Measure motor current
		MovingAverageA(ADC_readout_B[Current_A]);
		MovingAverageB(ADC_readout_B[Current_B]);

		// Check For Over-current Errors
		Error[0] = Motor_Error[0] & SDOC;
		Error[1] = Motor_Error[1] & SDOC;

		// Increase Duty cycle only if there is no Error
		// Motor A
		if	(CAN_Duty[0] == 0 )							// Forward Movement, Decelerating
			Duty[0] = CAN_Duty[0];
		else if	(CAN_Duty[0] >0 	&& 	CAN_Duty[0] <=  1000 		&& 	Duty[0] >= CAN_Duty[0])							// Forward Movement, Decelerating
			Duty[0] = CAN_Duty[0];
		else if (CAN_Duty[0] < 0 	&& 	CAN_Duty[0] >= -1000		&& 	Duty[0] <= CAN_Duty[0])							// Reverse Movement, Decelerating
			Duty[0] = CAN_Duty[0];
		else if (CAN_Duty[0] > 0 	&& 	CAN_Duty[0] <=  1000		&& 	Duty[0] <= CAN_Duty[0] 	&& 	Error[0] == OK)		// Forward Movement, Accelerating
			Duty[0] = CAN_Duty[0];
		else if (CAN_Duty[0] < 0 	&& 	CAN_Duty[0] >= -1000		&& 	Duty[0] >= CAN_Duty[0] 	&& 	Error[0] == OK)		// Reverse Movement, Accelerating
			Duty[0] = CAN_Duty[0];

		// Motor B
		if	(CAN_Duty[1] == 0 )							// Forward Movement, Decelerating
			Duty[1] = CAN_Duty[1];
		else if	(CAN_Duty[1] >0 	&& 	CAN_Duty[1] <=  1000		&& 	Duty[1] >= CAN_Duty[1])							// Forward Movement, Decelerating
			Duty[1] = CAN_Duty[1];
		else if (CAN_Duty[1] < 0 	&& 	CAN_Duty[1] >= -1000		&& 	Duty[1] <= CAN_Duty[1])							// Reverse Movement, Decelerating
			Duty[1] = CAN_Duty[1];
		else if (CAN_Duty[1] > 0 	&& 	CAN_Duty[1] <=  1000		&& 	Duty[1] <= CAN_Duty[1] 	&& 	Error[1] == OK)		// Forward Movement, Accelerating
			Duty[1] = CAN_Duty[1];
		else if (CAN_Duty[1] < 0 	&& 	CAN_Duty[1] >= -1000		&& 	Duty[1] >= CAN_Duty[1] 	&& 	Error[1] == OK)		// Reverse Movement, Accelerating
			Duty[1] = CAN_Duty[1];


		// Call Motor Control
		HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_SET);
		Duty[0] = Motor_Control(Duty[0], MOTOR_A);
		Duty[1] = Motor_Control(Duty[1], MOTOR_B);

		// Send Duty Data to Buffers
		Actual_Duty[0] = Duty[0];
		Actual_Duty[1] = Duty[1];
	}
	if (Input_KILL == 0)
		HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_RESET);
}

void InError(void)
{
	// Cut Power to motors, disable drivers
	HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(Power_EN_GPIO_Port, Power_EN_Pin, GPIO_PIN_RESET);
	// Set PWM to 0
	TIM2->CCR1 = 0;
	TIM2->CCR3 = 0;
	// Disable PWM Generation
	HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_1);
	HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_3);
}

// Filters and data
void MovingAverageA(uint16_t Measured_Current_A)
{
    static uint32_t Data_tableCA[16];
    static uint8_t Index;
    static uint16_t SumCA;

    SumCA = SumCA - Data_tableCA[Index];
    Data_tableCA[Index] = Measured_Current_A;
    SumCA = SumCA + Data_tableCA[Index];

    Index = (Index + 1) % 16;
    CurrentA_Average	= SumCA >> 4;
    if (CurrentA_Average > C_OFFSET)
     	CurrentA_Average = CurrentA_Average - C_OFFSET;
     else
     	CurrentA_Average = 0;
    Motor_Current[0] = (float)(CurrentA_Average) * Current_constant;
}

void MovingAverageB(uint16_t Measured_Current_B)
{
    static uint32_t Data_tableCB[16];
    static uint8_t Index;
    static uint16_t SumCB;

    SumCB = SumCB - Data_tableCB[Index];
    Data_tableCB[Index] = Measured_Current_B;
    SumCB = SumCB + Data_tableCB[Index];

    Index = (Index + 1) % 16;
    CurrentB_Average	= SumCB >> 4;
    if (CurrentB_Average > C_OFFSET)
     	CurrentB_Average = CurrentB_Average - C_OFFSET;
     else
     	CurrentB_Average = 0;
    Motor_Current[1] = (float)(CurrentB_Average) * Current_constant;
}


int16_t Motor_Control(int16_t Duty, uint8_t MOTOR)
{
	// Check all errors
	LDOC_check(MOTOR);
	Duty = OverCurrent_Compensation(Duty, MOTOR);
	Duty = OverTemp_Compensation(Duty, MOTOR);

	// Execute Ramp

	// Apply new Duty to motor
	Set_Motor(MOTOR, Duty);

	return Duty; // return applied duty to motor
}


int16_t OverCurrent_Compensation(int16_t Duty, uint8_t Motor)
{
	static uint8_t Error[2];

	if (Duty > 0) 									// Forward
	{
		if 	(Motor_Current[Motor] > Max_Current_Peak)
		{
			Duty--;
			Error[Motor] = SDOC;
		}
		else if (Duty < CAN_Duty[Motor])
			Duty++;
		else
			Error[Motor] = OK;
	}


	else if (Duty < 0) 								// reverse
	{
		if 	(Motor_Current[Motor] > Max_Current_Peak)
		{
			Duty++;
			Error[Motor] = SDOC;
		}
		else if (Duty > CAN_Duty[0])
			Duty--;
		else
			Error[Motor] = OK;
	}
	else
		if 	(Motor_Current[Motor] > Max_Current_Peak)
			Error[Motor] = SDOC;

		else
			Error[Motor] = OK;


	// Set Motor Error Global Flag
	if (Error[Motor] == SDOC)
		Motor_Error[Motor] = Motor_Error[Motor] | SDOC;
	else
		Motor_Error[Motor] = Motor_Error[Motor] & 0xFB;

	return Duty;
}
int16_t OverTemp_Compensation(int16_t Duty, uint8_t Motor)
{
	uint8_t Error = OK;

	if (FET_Temperature[Motor] > (FET_Temp_Limit - 20) && Duty > 0 && Duty > OVERTEMP_DUTY)
	{
		Duty = OVERTEMP_DUTY;
		// Reduce VREF
		Error = OVERTEMP_FET;
		Motor_Error[Motor] = Motor_Error[Motor] | Error;
	}

	if (Motor_Temperature[Motor] > (Motor_Temp_Limit - 20) && Duty > 0 && Duty > OVERTEMP_DUTY)
	{
		Duty = OVERTEMP_DUTY;
		// Reduce VREF
		Error = OVERTEMP_MOTOR;
		Motor_Error[Motor] = Motor_Error[Motor] | Error;
	}

	if (FET_Temperature[Motor] > FET_Temp_Limit || Motor_Temperature[Motor] > Motor_Temp_Limit)
	{
		Motor_Error[Motor] = Motor_Error[Motor] | CRITICAL_ERROR;
		EmergencyShutdown();
	}

	// Clear errors
	if (Error == OK)
		Motor_Error[Motor] = Motor_Error[Motor] & 0xE7;

	return Duty;
}

void EmergencyShutdown(void)
{
	MACHINE_STATE = ERROR;
	// Disable Drivers
	HAL_GPIO_WritePin(Driver_EN_GPIO_Port, Driver_EN_Pin, GPIO_PIN_RESET);
	// Shutdown Kill switch.
	HAL_GPIO_WritePin(Power_EN_GPIO_Port, Power_EN_Pin, GPIO_PIN_RESET);
}

uint8_t LDOC_check(uint8_t Motor)
{
	// execution of this function should be 10kHz
	// Cutoff time should be around 2s
	static uint32_t timer[2];
	uint8_t Status = OK;

	if (Motor_Current[Motor] > Max_Current_Continous && timer[Motor] < (LONG_DURATION_THRESHOLD * 10 ))			// if current higher than LDCL - set flag high
		timer[Motor]++;
	else
		timer[Motor] = 0;

	if (timer[Motor] >= (LONG_DURATION_THRESHOLD * 10 ))
	{
		Motor_Error[Motor] = Motor_Error[Motor] | LDOC;
		EmergencyShutdown();
	}
	return Status;
}

void Set_Motor (uint8_t motor, int16_t velocity)
{
//	uint16_t CCR_Value;
	if (velocity >= -1000 && velocity <=1000)
	{
		if(motor == MOTOR_A)
		{
			if(velocity >= 0 )			//	Forward
			{
//				CCR_Value = (velocity * TIM3->ARR) / 1000;
				TIM2->CCR3 = velocity;
				HAL_GPIO_WritePin(A_DIRECTION_GPIO_Port, A_DIRECTION_Pin, GPIO_PIN_SET);
			}
			else if (velocity < 0)		// Reverse
			{
//				CCR_Value = (-velocity * TIM3->ARR) / 1000;
				TIM2->CCR3 = -velocity;
				HAL_GPIO_WritePin(A_DIRECTION_GPIO_Port, A_DIRECTION_Pin, GPIO_PIN_RESET);
			}
		}
		else if(motor == MOTOR_B)
		{
			if(velocity >= 0 )			//	Forward
			{
//				CCR_Value = (velocity * TIM3->ARR) / 1000;
				TIM2->CCR1 = velocity;
				HAL_GPIO_WritePin(B_DIRECTION_GPIO_Port, B_DIRECTION_Pin, GPIO_PIN_RESET);
			}
			else if (velocity < 0 )		// Reverse
			{
//				CCR_Value = (-velocity * TIM3->ARR) / 1000;
				TIM2->CCR1 = -velocity;
				HAL_GPIO_WritePin(B_DIRECTION_GPIO_Port, B_DIRECTION_Pin, GPIO_PIN_SET);
			}
		}
	}
}

void Calculate_Temp (void)
{
	float temp;
	float rntc;

	if (ADC_readout_A[FET_Temp_A] < 4000)
	{
		rntc = (float)NTC_Series_Resistor / (((float)ADC_MAX_VALUE / (float)ADC_readout_A[FET_Temp_A]) - 1.0f);
		temp = rntc / (float)NTC_Nominal_Resistance;
		temp = logf(temp);
		temp /= (float)NTC_Beta;
		temp += 1.0f / ((float)NTC_Nominal_Temperature + 273.15f);
		temp = 1.0f / temp;
		temp -= 273.15f;
		FET_Temperature[MOTOR_A] = temp;
	}
	else
		FET_Temperature[MOTOR_A] = 0;

	if (ADC_readout_A[FET_Temp_B] < 4000)
	{
		rntc = (float)NTC_Series_Resistor / (((float)ADC_MAX_VALUE / (float)ADC_readout_A[FET_Temp_B]) - 1.0f);
		temp = rntc / (float)NTC_Nominal_Resistance;
		temp = logf(temp);
		temp /= (float)NTC_Beta;
		temp += 1.0f / ((float)NTC_Nominal_Temperature + 273.15f);
		temp = 1.0f / temp;
		temp -= 273.15f;
		FET_Temperature[MOTOR_B] = temp;
	}
	else
		FET_Temperature[MOTOR_B] = 0;

	if (ADC_readout_A[MOTOR_Temp_A] < 4000)
	{
		float rntc = (float)NTC_Series_Resistor / (((float)ADC_MAX_VALUE / (float)ADC_readout_A[MOTOR_Temp_A]) - 1.0f);
		float temp;
		temp = rntc / (float)NTC_Nominal_Resistance;
		temp = logf(temp);
		temp /= (float)NTC_Beta;
		temp += 1.0f / ((float)NTC_Nominal_Temperature + 273.15f);
		temp = 1.0f / temp;
		temp -= 273.15f;
		Motor_Temperature[MOTOR_A] = temp;
	}
	else
		Motor_Temperature[MOTOR_A] = 0;

	if (ADC_readout_A[MOTOR_Temp_B] < 4000)
	{
		rntc = (float)NTC_Series_Resistor / (((float)ADC_MAX_VALUE / (float)ADC_readout_A[MOTOR_Temp_B]) - 1.0f);
		temp = rntc / (float)NTC_Nominal_Resistance;
		temp = logf(temp);
		temp /= (float)NTC_Beta;
		temp += 1.0f / ((float)NTC_Nominal_Temperature + 273.15f);
		temp = 1.0f / temp;
		temp -= 273.15f;
		Motor_Temperature[MOTOR_B] = temp;
	}
	else
		Motor_Temperature[MOTOR_B] = 0;

	//return temp;
}

