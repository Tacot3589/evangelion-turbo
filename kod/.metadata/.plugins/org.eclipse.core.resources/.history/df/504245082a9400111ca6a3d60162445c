uint8_t SUMO_StartParameters(void)
{
	static uint16_t Delay_Timer;
	uint8_t ready = 1;
//	if(LINE_CAL_TYPE == 2 || Autocal == 1 )
	if(LINE_CAL_TYPE == 3)
	{
		if(ADC_readout[ADC_CHANNEL_LEFT_LINE_A] < Line_Color_Threshold)
		{
			ADC_threshold_HI = Line_Color_Threshold;
			ADC_threshold_LO = 0;
		}
		else
		{
			ADC_threshold_HI = 4096;
			ADC_threshold_LO = Line_Color_Threshold;
		}
	}
	Delay_Timer++;

	if(Delay_Timer >= SUMO_START_DELAY)
		ready = 1;
	else
		ready = 0;

	return ready;
}

void SUMO_PreStartParameters(void)
{
	if (FRONT_LEFT_Distance < 10)
		LastEnemyLocation = ENEMY_LEFT;
	if (FRONT_RIGHT_Distance < 10)
		LastEnemyLocation = ENEMY_RIGHT;
}

void pd_regulation(float angle_difference)
{
	static float last_error;
	int8_t motor_speed;
	motor_speed = angle_difference * KP + (angle_difference - last_error) * KD;
	if (motor_speed > PD_MAX_SPEED)
		motor_speed = PD_MAX_SPEED;
	else if (motor_speed < -PD_MAX_SPEED)
		motor_speed = -PD_MAX_SPEED;
	SET_MOTOR(motor_speed, - motor_speed);
	last_error = angle_difference;
}


