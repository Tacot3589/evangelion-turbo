void LIDARS_INIT(UART_HandleTypeDef *huart, DMA_HandleTypeDef *dma, uint8_t *RX)
{
	uint8_t counter=0;

	//LIDARS OFF
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x00;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huart, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(huart, RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LIDARS_INIT_ERR);
		counter++;
	}
	counter=0;
	HAL_Delay(50);


	//LIDARS SET 250Hz
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x06;
	UART_TX[2] = 0x03;
	UART_TX[3] = 0xFA;
	UART_TX[4] = 0x00;
	UART_TX[5] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huart, UART_TX, 6, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(huart, RX, 6, LIDARS_INIT_UART_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LIDARS_INIT_ERR);
		counter++;
	}
	counter=0;
	HAL_Delay(50);



	//LIDARS ON
	UART_TX[0] = 0x5A;
	UART_TX[1] = 0x05;
	UART_TX[2] = 0x07;
	UART_TX[3] = 0x01;
	UART_TX[4] = (UART_TX[0] + UART_TX[1] + UART_TX[2] + UART_TX[3]) % 0x100;
	counter=0;
	while(true)
	{
		HAL_UART_Transmit(huart, UART_TX, 5, LIDARS_INIT_UART_TIMEOUT);
		HAL_UART_Receive(huart, RX, 5, LIDARS_INIT_UART_TIMEOUT);

		if(RX[0] == UART_TX[0] && RX[1] == UART_TX[1] && RX[2] == UART_TX[2])
			break;
		if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LIDARS_INIT_ERR);
		counter++;
	}
	HAL_Delay(50);


	counter=0;
	while(true)
	{

		if(huart->RxState == HAL_UART_STATE_READY && huart->gState == HAL_UART_STATE_READY && huart->ErrorCode == HAL_UART_ERROR_NONE)
			break;
		else if(counter >= MAX_RETRIES_LIDARS_INIT)
			COOKED(LIDARS_INIT_ERR);

		HAL_Delay(LIDARS_INIT_UART_TIMEOUT);
		counter++;
	}

	HAL_Delay(50);


	HAL_UART_AbortReceive(huart);
	__HAL_UART_CLEAR_OREFLAG(huart);
	huart->ErrorCode = HAL_UART_ERROR_NONE;
	huart->RxState   = HAL_UART_STATE_READY;
	huart->gState = HAL_UART_STATE_READY;
	if(HAL_UARTEx_ReceiveToIdle_DMA(huart, RX, 9) != HAL_OK)
		COOKED(LIDARS_INIT_ERR);
	__HAL_DMA_DISABLE_IT(dma, DMA_IT_HT);
}


void PLAY_FREQ(uint16_t f_hz)
{
	f_hz = f_hz * DEFAULT_SETTING_ENABLE_BUZZER;
    if (f_hz == 0) {
        __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, 0);
        return;
    }

    // Stały PSC=169 -> licznik 1 MHz (TIMCLK 170 MHz / (169+1))
    __HAL_TIM_SET_PRESCALER(&htim3, 169);

    uint32_t arr = 1000000UL / f_hz;            // okres w tickach 1 MHz
    if (arr == 0) arr = 1;                      // minimalna wartość
    arr -= 1;                                   // rejestrowo

    __HAL_TIM_DISABLE(&htim3);
    __HAL_TIM_SET_AUTORELOAD(&htim3, (uint16_t)arr);
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, (uint16_t)(((arr + 1U) >> 1)));
    __HAL_TIM_SET_COUNTER(&htim3, 0);
    __HAL_TIM_ENABLE(&htim3);
    HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
}


