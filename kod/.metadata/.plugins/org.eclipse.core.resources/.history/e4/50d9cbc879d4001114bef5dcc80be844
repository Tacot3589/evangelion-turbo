/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	Lunas.FrontLeft.huartRX = &hlpuart1;
	Lunas.FrontRight.huartRX = &huart2;
	Lunas.BackLeft.huartRX = &huart3;
	Lunas.BackRight.huartRX = &huart4;
	Lunas.huartTX = &huart2;
	Lunas.FrontLeft.RXsize = sizeof Lunas.FrontLeft.RX;
	Lunas.FrontRight.RXsize = sizeof Lunas.FrontRight.RX;
	Lunas.BackLeft.RXsize = sizeof Lunas.BackLeft.RX;
	Lunas.BackRight.RXsize = sizeof Lunas.BackRight.RX;

	JoystickState = _NOTHING;

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  HAL_Delay(INIT_DELAY*2);

  //blink leds
  HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, 1);
  HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, 1);
  HAL_GPIO_WritePin(LED_BLUE_GPIO_Port, LED_BLUE_Pin, 1);

  //Disable SPI for drivers
  HAL_GPIO_WritePin(DRV_CS_1_GPIO_Port, DRV_CS_1_Pin, 1);
  HAL_GPIO_WritePin(DRV_CS_2_GPIO_Port, DRV_CS_2_Pin, 1);

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_ADC2_Init();
  MX_I2C1_Init();
  MX_I2C2_Init();
  MX_LPUART1_UART_Init();
  MX_UART4_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_SPI2_Init();
  MX_TIM4_Init();
  MX_TIM8_Init();
  MX_TIM15_Init();
  MX_TIM16_Init();
  MX_TIM17_Init();
  MX_TIM7_Init();
  MX_TIM6_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */

	//============================= OLED
	if(ssd1306_Init()==0)
		Error_Handler();
	ssd1306_Clear();
	ssd1306_SetColor(White);
	ssd1306_Fill();
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);

	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("TURBO", 20, BIG);
	_ssd1306_WriteInTheMiddle("EVANGELION", 40, BIG);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);


	//============================= START MOD
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("START MODULE...", 30, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);
	StartModule_Startup();


	//============================= LIDARS
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("LIDARs INIT...", 30, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);
	if(TFLUNAs_INIT(&Lunas) != HAL_OK) Error_Handler();

	//============================= ADCs
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("ADCs...", 30, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);
	if(ADC_READOUT_INIT(&hadc1, ADC1_BUFFER, 6) != HAL_OK) Error_Handler();
	if(ADC_READOUT_INIT(&hadc2, ADC2_BUFFER, 6) != HAL_OK) Error_Handler();


	//============================= DRIVERS
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("DRIVERS...", 30, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);
	if(DRIVERS_INIT(&hspi2) != HAL_OK) Error_Handler();


	//============================= Performance
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("PERFORMANCE...", 30, SMALL);
	ssd1306_UpdateScreen();
	HAL_Delay(INIT_DELAY);
	DWT_Init();

	//============================= TIMERS
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("INIT", 10, BIG);
	_ssd1306_WriteInTheMiddle("TIMERS...", 30, SMALL);
	ssd1306_UpdateScreen();

	HAL_TIM_Base_Start(&htim4); //PWM A
	HAL_TIM_Base_Start(&htim8); //PWM B
	HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
	HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
	HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_1);
	HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_3);

	HAL_TIM_Base_Start_IT(&htim6); //about 20Hz, start mod led
	HAL_TIM_Base_Start_IT(&htim7); //1MHz clock, 65.5ms, start mod
	HAL_TIM_Base_Start_IT(&htim16); //1kHz
	HAL_TIM_Base_Start_IT(&htim17); //100Hz
	HAL_TIM_Base_Start_IT(&htim15); //25Hz

	//============================= DONE!
	ssd1306_Clear();
	_ssd1306_WriteInTheMiddle("TURBO", 20, BIG);
	_ssd1306_WriteInTheMiddle("EVANGELION", 40, BIG);
	ssd1306_UpdateScreen();
	HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, 0);
	HAL_GPIO_WritePin(LED_BLUE_GPIO_Port, LED_BLUE_Pin, 0);
	HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, 0);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	uint32_t start = DWT->CYCCNT;
	__WFI();
	cpu_idle_cycles += (DWT->CYCCNT - start);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

